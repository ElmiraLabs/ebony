// Burin contre un VRAI PostgreSQL : le texte et les paramètres du constructeur sont acceptés par le serveur, RETURNING rend les clés générées, les lignes se lisent avec le bon type OWL (booléen natif, entier, réel,
// date en texte), les jointures et le comptage marchent, un décalage seul s'écrit OFFSET, une requête refusée lève 500. Modèle joué par tests/integration/postgresql.ps1 dans un projet généré (--base postgresql) :
// @PORT@ et @BASE@ sont remplacés par le port et la base du serveur jetable. Ce fichier n'est pas un test du dépôt (extension .tpl) : il ne compile que dans un projet généré, qui a la bibliothèque dans ebony/.

PROCEDURE PgConnexion() : cEbConnexionSqlReelle
	cnx est une sqlConnexion
	cnx..Provider = sqlPostgres
	cnx..Serveur = "127.0.0.1:@PORT@"
	cnx..BaseDeDonnées = "@BASE@"
	cnx..Utilisateur = "postgres"
	cnx..MotDePasse = "ebonytest"
	cnx..ModeTLS = tlsDesactive
	oConnexion est un cEbConnexionSqlReelle(cnx, "SELECT 1")
	oConnexion.Ouvre()
	RENVOYER oConnexion
FIN

gCnxPg est un cEbConnexionSqlReelle = PgConnexion()

PROCEDURE PgBurin() : cEbBurin
	oDialecte est un cEbDialectePostgresql
	oBurin    est un cEbBurin(oDialecte)
	RENVOYER oBurin
FIN

PROCEDURE PgProduits() : cEbTable
	oTable est un cEbTable("burin_produits")
	oTable.AjouteColonne("id", "entier", Vrai, Vrai)
	oTable.AjouteColonne("nom", "texte", Vrai, Faux)
	oTable.AjouteColonne("prix", "reel", Faux, Faux)
	oTable.AjouteColonne("actif", "booleen", Faux, Faux)
	oTable.AjouteColonne("cree_le", "dateheure", Faux, Faux)
	RENVOYER oTable
FIN

PROCEDURE PgCategories() : cEbTable
	oTable est un cEbTable("burin_categories")
	oTable.AjouteColonne("id", "entier", Vrai, Vrai)
	oTable.AjouteColonne("nom", "texte", Vrai, Faux)
	RENVOYER oTable
FIN

PROCEDURE PgArticles() : cEbTable
	oTable est un cEbTable("burin_articles")
	oTable.AjouteColonne("id", "entier", Vrai, Vrai)
	oTable.AjouteColonne("nom", "texte", Vrai, Faux)
	oTable.AjouteColonne("categorie_id", "entier", Faux, Faux)
	RENVOYER oTable
FIN

// Les tables sont recréées vides avant chaque scénario.
PROCEDURE avantChaqueTest()
	gCnxPg = PgConnexion()
	tabAucun est un tableau associatif
	gCnxPg.Envoie("DROP TABLE IF EXISTS burin_articles", tabAucun)
	gCnxPg.Envoie("DROP TABLE IF EXISTS burin_categories", tabAucun)
	gCnxPg.Envoie("DROP TABLE IF EXISTS burin_produits", tabAucun)
	gCnxPg.Envoie("CREATE TABLE burin_produits (id INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, nom TEXT NOT NULL, prix DOUBLE PRECISION, actif BOOLEAN, cree_le TIMESTAMP)", tabAucun)
	gCnxPg.Envoie("CREATE TABLE burin_categories (id INTEGER NOT NULL PRIMARY KEY, nom TEXT NOT NULL)", tabAucun)
	gCnxPg.Envoie("CREATE TABLE burin_articles (id INTEGER NOT NULL PRIMARY KEY, nom TEXT NOT NULL, categorie_id INTEGER)", tabAucun)
FIN

PROCEDURE apresChaqueTest()
	tabAucun est un tableau associatif
	gCnxPg.Envoie("DROP TABLE IF EXISTS burin_articles", tabAucun)
	gCnxPg.Envoie("DROP TABLE IF EXISTS burin_categories", tabAucun)
	gCnxPg.Envoie("DROP TABLE IF EXISTS burin_produits", tabAucun)
	gCnxPg.Ferme()
FIN

PROCEDURE PgLigneProduit(sNom est une chaîne, prix est un JSON, bActif est un booléen, creation est un JSON) : tableau associatif
	tabLigne est un tableau associatif
	tabLigne["nom"] = sNom
	tabLigne["prix"] = prix
	tabLigne["actif"] = bActif
	tabLigne["cree_le"] = creation
	RENVOYER tabLigne
FIN

// Le nombre de lignes rendues par cette requête, envoyée sur PostgreSQL.
PROCEDURE PgNombre(oRequete est un cEbRequete) : entier
	tabLignes est un tableau = EbLignesDe(EbEnvoieRequete(gCnxPg, oRequete))
	RENVOYER tabLignes..Occurrence
FIN

// Les noms des produits, triés par id, séparés par « , ».
PROCEDURE PgNoms() : chaîne
	oBurin    est un cEbBurin   = PgBurin()
	oProduits est un cEbTable   = PgProduits()
	oId       est un cEbColonne = oProduits.ColonneNommee("id")
	oNom      est un cEbColonne = oProduits.ColonneNommee("nom")
	sNoms     est une chaîne    = ""
	POUR TOUT oCandidate DE EbLignesDe(EbEnvoieRequete(gCnxPg, oBurin.Select().From(oProduits).OrderBy(oId.Asc()).ToSQL()))
		oLigne est un cEbLigne = oCandidate
		sNoms += EbSeparateurSql(sNoms) + oLigne.LitTexte(oNom)
	FIN
	RENVOYER sNoms
FIN

// Un Insert avec RETURNING : la clé générée par PostgreSQL revient sous son alias ; chaque nature se relit avec son type (booléen natif, réel, texte accentué, date-heure en texte).
PROCEDURE scenario_insert_returning_et_lecture_de_chaque_nature_sur_postgresql()
	oBurin    est un cEbBurin   = PgBurin()
	oProduits est un cEbTable   = PgProduits()
	oId       est un cEbColonne = oProduits.ColonneNommee("id")
	oInsert   est un cEbInsert  = oBurin.Insert(oProduits)
	oInsert.Values(PgLigneProduit("café", 12.5, Vrai, "2026-11-13 10:30:00")).Values(PgLigneProduit("thé", 8, Faux, Null)).Returning(oId)
	oRetour   est un cEbResultatSql = EbEnvoieRequete(gCnxPg, oInsert.ToSQL())
	dbgVérifieEgalité(oRetour.NbLignes(), 2, "deux clés rendues par RETURNING")
	oPremiere est un cEbLigne = EbLignesDe(oRetour)[1]
	dbgVérifieEgalité(oPremiere.LitEntier(oId), 1, "la première clé générée")
	oLues     est un cEbResultatSql = EbEnvoieRequete(gCnxPg, oBurin.Select().From(oProduits).OrderBy(oId.Asc()).ToSQL())
	oCafe     est un cEbLigne = EbLignesDe(oLues)[1]
	dbgVérifieEgalité(oCafe.LitTexte(oProduits.ColonneNommee("nom")), "café", "texte accentué")
	dbgVérifieEgalité(oCafe.LitReel(oProduits.ColonneNommee("prix")), 12.5, "réel")
	dbgVérifieVrai(oCafe.LitBooleen(oProduits.ColonneNommee("actif")), "booléen Vrai (natif)")
	dbgVérifieEgalité(oCafe.LitDate(oProduits.ColonneNommee("cree_le")), "2026-11-13 10:30:00", "date-heure en texte")
	oThe      est un cEbLigne = EbLignesDe(oLues)[2]
	dbgVérifieEgalité(oThe.LitReel(oProduits.ColonneNommee("prix")), 8, "un entier écrit dans un double")
	dbgVérifieFaux(oThe.LitBooleen(oProduits.ColonneNommee("actif")), "booléen Faux")
	dbgVérifieVrai(oThe.EstNull(oProduits.ColonneNommee("cree_le")), "date NULL")
	dbgVérifieEgalité(oThe.LitDate(oProduits.ColonneNommee("cree_le")), "", "date NULL lue « »")
FIN

// Update puis Del avec condition et RETURNING ; le garde-fou refuse un Del sans condition avant tout envoi.
PROCEDURE scenario_update_del_et_garde_fou_sur_postgresql()
	oBurin    est un cEbBurin   = PgBurin()
	oProduits est un cEbTable   = PgProduits()
	oId       est un cEbColonne = oProduits.ColonneNommee("id")
	oNom      est un cEbColonne = oProduits.ColonneNommee("nom")
	EbEnvoieRequete(gCnxPg, oBurin.Insert(oProduits).Values(PgLigneProduit("café", 12.5, Vrai, Null)).Values(PgLigneProduit("thé", 8, Vrai, Null)).ToSQL())
	tabNouveau est un tableau associatif
	tabNouveau["nom"] = "café noir"
	tabNouveau["prix"] = Null
	oModifie  est un cEbResultatSql = EbEnvoieRequete(gCnxPg, oBurin.Update(oProduits).Set(tabNouveau).Where(oNom.Eq("café")).Returning(oId).ToSQL())
	dbgVérifieEgalité(oModifie.NbLignes(), 1, "une ligne modifiée, rendue par RETURNING")
	dbgVérifieEgalité(PgNoms(), "café noir, thé", "seule la ligne visée a changé")
	oEfface   est un cEbResultatSql = EbEnvoieRequete(gCnxPg, oBurin.Del(oProduits).Where(oNom.Eq("thé")).Returning(oId).ToSQL())
	oLigneEffacee est un cEbLigne = EbLignesDe(oEfface)[1]
	dbgVérifieEgalité(oLigneEffacee.LitEntier(oId), 2, "la clé de la ligne effacée")
	sRefus    est une chaîne = ""
	QUAND EXCEPTION DANS
		oEssai est un cEbRequete = oBurin.Del(oProduits).ToSQL()
	FAIRE
		sRefus = ExceptionInfo(errCode)
	FIN
	dbgVérifieEgalité(sRefus, "7008", "Del sans condition refusé")
	dbgVérifieEgalité(PgNoms(), "café noir", "il reste la ligne non visée")
FIN

// Une injection reste une valeur ; Like, Between et IsIn passent par des paramètres typés.
PROCEDURE scenario_conditions_et_injection_sur_postgresql()
	oBurin    est un cEbBurin   = PgBurin()
	oProduits est un cEbTable   = PgProduits()
	oNom      est un cEbColonne = oProduits.ColonneNommee("nom")
	oPrix     est un cEbColonne = oProduits.ColonneNommee("prix")
	sPiege    est une chaîne    = `x'); DROP TABLE burin_produits; --`
	EbEnvoieRequete(gCnxPg, oBurin.Insert(oProduits).Values(PgLigneProduit(sPiege, 1, Vrai, Null)).Values(PgLigneProduit("café", 12.5, Vrai, Null)).Values(PgLigneProduit("thé", 8, Faux, Null)).ToSQL())
	dbgVérifieEgalité(PgNombre(oBurin.Select().From(oProduits).Where(oNom.Eq(sPiege)).ToSQL()), 1, "la valeur piège est retrouvée intacte, la table existe")
	dbgVérifieEgalité(PgNombre(oBurin.Select().From(oProduits).Where(oNom.Like("c%")).ToSQL()), 1, "Like")
	dbgVérifieEgalité(PgNombre(oBurin.Select().From(oProduits).Where(oPrix.Between(5, 20)).ToSQL()), 2, "Between")
	tabNoms est un tableau
	TableauAjoute(tabNoms, "café")
	TableauAjoute(tabNoms, "thé")
	dbgVérifieEgalité(PgNombre(oBurin.Select().From(oProduits).Where(oNom.IsIn(tabNoms)).ToSQL()), 2, "IsIn")
FIN

// Limit et Offset : un décalage SEUL s'écrit OFFSET (PostgreSQL l'accepte), avec ordre ; limite et décalage ensemble.
PROCEDURE scenario_limit_et_offset_sur_postgresql()
	oBurin    est un cEbBurin   = PgBurin()
	oProduits est un cEbTable   = PgProduits()
	oId       est un cEbColonne = oProduits.ColonneNommee("id")
	oInsert   est un cEbInsert  = oBurin.Insert(oProduits)
	oInsert.Values(PgLigneProduit("a", 1, Vrai, Null)).Values(PgLigneProduit("b", 2, Vrai, Null)).Values(PgLigneProduit("c", 3, Vrai, Null)).Values(PgLigneProduit("d", 4, Vrai, Null))
	EbEnvoieRequete(gCnxPg, oInsert.ToSQL())
	dbgVérifieEgalité(PgNombre(oBurin.Select().From(oProduits).OrderBy(oId.Asc()).Limit(2).ToSQL()), 2, "Limit(2)")
	dbgVérifieEgalité(PgNombre(oBurin.Select().From(oProduits).OrderBy(oId.Asc()).Offset(3).ToSQL()), 1, "Offset(3) seul : une ligne")
	oPage     est un cEbResultatSql = EbEnvoieRequete(gCnxPg, oBurin.Select().From(oProduits).OrderBy(oId.Asc()).Limit(2).Offset(1).ToSQL())
	oPremiere est un cEbLigne       = EbLignesDe(oPage)[1]
	dbgVérifieEgalité(oPremiere.LitEntier(oId), 2, "Limit(2).Offset(1) : commence à la deuxième ligne")
FIN

// Jointures et comptage : les deux « nom » se lisent séparément, la jointure gauche garde l'article sans catégorie (colonne NULL lue « »), COUNT rend un entier qui ignore ordre et limite.
PROCEDURE scenario_jointures_et_count_sur_postgresql()
	oBurin       est un cEbBurin   = PgBurin()
	oArticles    est un cEbTable   = PgArticles()
	oCategories  est un cEbTable   = PgCategories()
	tabCategorie est un tableau associatif
	tabCategorie["id"] = 1
	tabCategorie["nom"] = "livres"
	EbEnvoieRequete(gCnxPg, oBurin.Insert(oCategories).Values(tabCategorie).ToSQL())
	tabAvec est un tableau associatif
	tabAvec["id"] = 10
	tabAvec["nom"] = "roman"
	tabAvec["categorie_id"] = 1
	tabSans est un tableau associatif
	tabSans["id"] = 11
	tabSans["nom"] = "orphelin"
	EbEnvoieRequete(gCnxPg, oBurin.Insert(oArticles).Values(tabAvec).ToSQL())
	EbEnvoieRequete(gCnxPg, oBurin.Insert(oArticles).Values(tabSans).ToSQL())
	oCle       est un cEbColonne = oArticles.ColonneNommee("categorie_id")
	oId        est un cEbColonne = oCategories.ColonneNommee("id")
	oIdArticle est un cEbColonne = oArticles.ColonneNommee("id")
	oInterne   est un cEbResultatSql = EbEnvoieRequete(gCnxPg, oBurin.Select().From(oArticles).InnerJoin(oCategories, oCle.EqCol(oId)).ToSQL())
	dbgVérifieEgalité(oInterne.NbLignes(), 1, "jointure interne : un article a une catégorie")
	oGauche    est un cEbResultatSql = EbEnvoieRequete(gCnxPg, oBurin.Select().From(oArticles).LeftJoin(oCategories, oCle.EqCol(oId)).OrderBy(oIdArticle.Asc()).ToSQL())
	dbgVérifieEgalité(oGauche.NbLignes(), 2, "jointure gauche : les deux articles")
	oRoman     est un cEbLigne = EbLignesDe(oGauche)[1]
	dbgVérifieEgalité(oRoman.LitTexte(oArticles.ColonneNommee("nom")), "roman", "le nom de l'article")
	dbgVérifieEgalité(oRoman.LitTexte(oCategories.ColonneNommee("nom")), "livres", "le nom de la catégorie, sans confusion")
	oOrphelin  est un cEbLigne = EbLignesDe(oGauche)[2]
	dbgVérifieVrai(oOrphelin.EstNull(oCategories.ColonneNommee("nom")), "pas de catégorie : NULL")
	oCompte    est un cEbResultatSql = EbEnvoieRequete(gCnxPg, oBurin.Select().From(oArticles).InnerJoin(oCategories, oCle.EqCol(oId)).OrderBy(oIdArticle.Asc()).Limit(1).ToSQLCount())
	tabCompte  est un tableau associatif = oCompte.Lignes()[1]
	dbgVérifieEgalité(tabCompte["total"], 1, "COUNT de la jointure interne")
	dbgVérifieEgalité(TypeVar(tabCompte["total"]), owlEntier, "le total est un entier")
FIN

// Une requête refusée par PostgreSQL lève 500 avec son message.
PROCEDURE scenario_requete_refusee_leve_500_sur_postgresql()
	oBurin    est un cEbBurin   = PgBurin()
	oProduits est un cEbTable   = PgProduits()
	tabAucun  est un tableau associatif
	oRequete  est un cEbRequete = oBurin.Select().From(oProduits).Where(oBurin.Raw("colonne_inexistante > 1", tabAucun)).ToSQL()
	nCode     est un entier     = 0
	sMessage  est une chaîne    = ""
	QUAND EXCEPTION DANS
		oEssai est un cEbResultatSql = EbEnvoieRequete(gCnxPg, oRequete)
	FAIRE
		nCode = ExceptionInfo(errCode)
		sMessage = ExceptionInfo(errMessage)
	FIN
	dbgVérifieEgalité(nCode, 500, "500")
	dbgVérifieVrai(Taille(sMessage) > 0, "le message de PostgreSQL est donné")
FIN
