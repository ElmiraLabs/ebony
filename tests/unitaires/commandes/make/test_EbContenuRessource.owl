// Tests de EbContenuRessource et EbContenuMigration : les propriétés du texte généré (fichiers prévus, fins de ligne, identifiants préfixés, rien d'un mot de l'utilisateur tel quel).
// Que ce texte COMPILE et que ses tests PASSENT est prouvé par tests/integration/lanceur.ps1 (groupe « make »), contre le vrai owl : un faux disque ne le montre pas.

// La demande lue dans des arguments écrits avec des « ; ».
PROCEDURE EbTestDemandeContenu(sListe est une chaîne) : cEbDemandeMake
	tabArgs est un tableau de chaînes
	nDebut  est un entier             = 1
	nFin    est un entier             = Position(sListe, ";")
	TANTQUE nFin > 0
		TableauAjoute(tabArgs, Milieu(sListe, nDebut, nFin - nDebut))
		nDebut = nFin + 1
		nFin   = Position(sListe, ";", nDebut)
	FIN
	TableauAjoute(tabArgs, Milieu(sListe, nDebut))
	oDemande est un cEbDemandeMake = EbAnalyseArgumentsMake(tabArgs)
	RENVOYER oDemande
FIN

// Les treize fichiers d'une ressource, dans l'ordre, sous app/ et tests/, avec des barres obliques.
PROCEDURE scenario_fichiers_d_une_ressource()
	oDemande est un cEbDemandeMake = EbTestDemandeContenu("resource;Bon de commande;--champs;id:entier*,nom:texte")
	dbgVérifieEgalité(EbListeVirgules(EbFichiersRessource(oDemande)), "app/domaine/bon-de-commande/cBonDeCommande.owl, app/domaine/bon-de-commande/ContratsBonDeCommande.owl, app/donnees/bon-de-commande/cRepoBonDeCommandeMemoire.owl, app/donnees/bon-de-commande/cRepoBonDeCommandeSql.owl, tests/unitaires/bon-de-commande/test_cBonDeCommande.owl, tests/unitaires/bon-de-commande/test_cRepoBonDeCommandeMemoire.owl, tests/integration/bon-de-commande/test_cRepoBonDeCommandeSql.owl, app/services/bon-de-commande/cServiceBonDeCommande.owl, tests/unitaires/bon-de-commande/test_cServiceBonDeCommande.owl, app/domaine/bon-de-commande/ressource.json, database/factories/bon-de-commande/cFabriqueBonDeCommande.owl, app/http/bon-de-commande/CorpsBonDeCommande.owl, app/http/bon-de-commande/ControleurBonDeCommande.owl", "chemins")
FIN

// Chaque fichier produit est en LF, sans tabulation en fin de ligne, et se termine par un saut de ligne.
PROCEDURE scenario_fichiers_en_lf_avec_saut_final()
	oDemande est un cEbDemandeMake = EbTestDemandeContenu("resource;Client;--champs;id:entier*,nom:texte,email:texte?")
	POUR i = 1 À 8
		sContenu est une chaîne = EbContenuFichierRessource(oDemande, i)
		dbgVérifieEgalité(Droite(sContenu, 1), Caract(10), "saut de ligne final du fichier " + i)
		dbgVérifieEgalité(Position(sContenu, Caract(13)), 0, "pas de retour chariot dans le fichier " + i)
		dbgVérifieEgalité(Position(sContenu, Caract(10) + Caract(10) + Caract(10)), 0, "pas de double ligne vide dans le fichier " + i)
	FIN
FIN

// L'entité : champs privés préfixés par leur type, constructeur à paramètres préfixés, accesseurs Lit…, jamais le mot de l'utilisateur seul.
PROCEDURE scenario_entite_sans_mot_de_l_utilisateur_nu()
	oDemande est un cEbDemandeMake = EbTestDemandeContenu("resource;Client;--champs;id:entier*,Date:date,etat:texte?,actif:booleen,note:reel")
	sEntite  est une chaîne        = EbContenuEntite(oDemande)
	dbgVérifieVrai(Position(sEntite, "cClient est une Classe") > 0, "classe cClient")
	dbgVérifieVrai(Position(sEntite, "PRIVÉ") > 0, "bloc PRIVÉ")
	dbgVérifieVrai(Position(sEntite, Caract(9) + "nId est un entier = 0") > 0, "champ entier")
	dbgVérifieVrai(Position(sEntite, Caract(9) + "sDate est une chaîne = " + Caract(34) + Caract(34)) > 0, "date : chaîne, champ sDate")
	dbgVérifieVrai(Position(sEntite, Caract(9) + "bActif est un booléen = Faux") > 0, "champ booléen")
	dbgVérifieVrai(Position(sEntite, Caract(9) + "rNote est un réel = 0") > 0, "champ réel")
	dbgVérifieVrai(Position(sEntite, "PROCEDURE Constructeur(vId est un entier, vDate est une chaîne, vEtat est une chaîne, vActif est un booléen, vNote est un réel)") > 0, "constructeur")
	dbgVérifieVrai(Position(sEntite, "PROCEDURE PUBLIQUE LitDate() : chaîne") > 0, "accesseur LitDate (Date est un mot réservé)")
	dbgVérifieVrai(Position(sEntite, "PROCEDURE PUBLIQUE LitEtat() : chaîne") > 0, "accesseur LitEtat (Etat est un mot réservé)")
	dbgVérifieEgalité(Position(sEntite, "PROCEDURE PUBLIQUE Date("), 0, "jamais Date()")
	dbgVérifieEgalité(Position(sEntite, "PROCEDURE PUBLIQUE Etat("), 0, "jamais Etat()")
FIN

// Le contrat est dans une Collection, avec le type de la clé : entier ou chaîne.
PROCEDURE scenario_contrat_dans_une_collection()
	sEntier est une chaîne = EbContenuContrats(EbTestDemandeContenu("resource;Client;--champs;id:entier*,nom:texte"))
	sTexte  est une chaîne = EbContenuContrats(EbTestDemandeContenu("resource;Pays;--champs;code:texte*,nom:texte"))
	dbgVérifieVrai(Position(sEntier, "ContratsClient est une CollectionDeProcédures") > 0, "Collection")
	dbgVérifieVrai(Position(sEntier, "iRepoClient est une Interface") > 0, "interface")
	dbgVérifieVrai(Position(sEntier, "PROCEDURE PUBLIQUE Trouve(cle est un entier) : cClient") > 0, "clé entière")
	dbgVérifieVrai(Position(sTexte, "PROCEDURE PUBLIQUE Trouve(cle est une chaîne) : cPays") > 0, "clé texte")
FIN

// Le repository SQL est écrit avec Burin : il décrit sa table, n'écrit aucun SQL à la main (donc aucune valeur dans un texte), passe par la connexion résiliente, et une clé générée est rendue par RETURNING (Returning de Burin).
PROCEDURE scenario_depot_sql_avec_burin()
	sSql est une chaîne = EbContenuDepotSql(EbTestDemandeContenu("resource;Client;--champs;id:entier*,nom:texte"))
	dbgVérifieVrai(Position(sSql, "cRepoClientSql est une Classe implemente iRepoClient") > 0, "implémente l'interface")
	dbgVérifieVrai(Position(sSql, "oBase  est un cEbBaseResiliente") > 0, "connexion résiliente")
	dbgVérifieVrai(Position(sSql, ":oBurin = base.Burin()") > 0, "Burin vient de la base : le dialecte est celui de la base")
	dbgVérifieVrai(Position(sSql, `oDefinition est un cEbTable("clients")`) > 0, "la table est décrite")
	dbgVérifieVrai(Position(sSql, `oDefinition.AjouteColonne("id", "entier", Vrai, Vrai)`) > 0, "la clé : nature, NOT NULL, clé")
	dbgVérifieVrai(Position(sSql, `oDefinition.AjouteColonne("nom", "texte", Vrai, Faux)`) > 0, "une colonne ordinaire")
	dbgVérifieVrai(Position(sSql, ".Returning(:ColonneDe(" + Caract(34) + "id" + Caract(34) + "))") > 0, "clé générée rendue")
	dbgVérifieVrai(Position(sSql, "ExceptionDéclenche(404, ") > 0, "404 introuvable")
	dbgVérifieVrai(Position(sSql, `tabLigne["nom"] = entite.LitNom()`) > 0, "les valeurs passent par le constructeur de requêtes")
	dbgVérifieEgalité(Position(sSql, "SELECT "), 0, "aucun SQL écrit à la main")
	dbgVérifieEgalité(Position(sSql, `tabLigne["id"] = entite.LitId()`), 0, "la clé donnée par la base n'est jamais écrite")
FIN

// Chaque colonne est lue selon sa nature (un NULL devient la valeur par défaut du type) ; une colonne nullable est décrite comme telle ; un nom de table ou de colonne spécial reste dans des chaînes.
PROCEDURE scenario_depot_sql_lit_chaque_nature()
	sSql est une chaîne = EbContenuDepotSql(EbTestDemandeContenu("resource;Commande;--table;order;--champs;id:entier*,Date de naissance:date,user:texte?,actif:booleen,solde:reel"))
	dbgVérifieVrai(Position(sSql, `oDefinition est un cEbTable("order")`) > 0, "un mot du SQL comme nom de table")
	dbgVérifieVrai(Position(sSql, `oDefinition.AjouteColonne("Date de naissance", "date", Vrai, Faux)`) > 0, "un nom avec espaces")
	dbgVérifieVrai(Position(sSql, `oDefinition.AjouteColonne("user", "texte", Faux, Faux)`) > 0, "une colonne nullable n'exige pas de valeur")
	dbgVérifieVrai(Position(sSql, "oLigne.LitEntier(:ColonneDe(" + Caract(34) + "id" + Caract(34) + "))") > 0, "entier")
	dbgVérifieVrai(Position(sSql, "oLigne.LitDate(:ColonneDe(" + Caract(34) + "Date de naissance" + Caract(34) + "))") > 0, "date")
	dbgVérifieVrai(Position(sSql, "oLigne.LitTexte(:ColonneDe(" + Caract(34) + "user" + Caract(34) + "))") > 0, "texte")
	dbgVérifieVrai(Position(sSql, "oLigne.LitBooleen(:ColonneDe(" + Caract(34) + "actif" + Caract(34) + "))") > 0, "booléen")
	dbgVérifieVrai(Position(sSql, "oLigne.LitReel(:ColonneDe(" + Caract(34) + "solde" + Caract(34) + "))") > 0, "réel")
FIN

// Une clé texte est fournie par l'appelant : le repository vérifie qu'elle est libre (409), l'écrit, et n'a pas de Returning.
PROCEDURE scenario_depot_sql_cle_texte()
	sSql est une chaîne = EbContenuDepotSql(EbTestDemandeContenu("resource;Pays;--champs;code:texte*,nom:texte"))
	dbgVérifieVrai(Position(sSql, "ExceptionDéclenche(409, ") > 0, "409 clé déjà prise")
	dbgVérifieVrai(Position(sSql, `tabLigne["code"] = entite.LitCode()`) > 0, "la clé est écrite")
	dbgVérifieEgalité(Position(sSql, "Returning("), 0, "pas de Returning : la clé est connue")
FIN
// Le test SQL ferme sa connexion après chaque scénario (fixtures), et ne teste le NULL que s'il y a une colonne nullable.
PROCEDURE scenario_test_sql_fixtures_et_null()
	sSans est une chaîne = EbContenuTestDepotSql(EbTestDemandeContenu("resource;Client;--champs;id:entier*,nom:texte"))
	sAvec est une chaîne = EbContenuTestDepotSql(EbTestDemandeContenu("resource;Client;--champs;id:entier*,nom:texte,email:texte?"))
	dbgVérifieVrai(Position(sSans, "PROCEDURE apresChaqueTest()") > 0, "fixture de fermeture")
	dbgVérifieVrai(Position(sSans, "gBaseClient.Ferme()") > 0, "ferme la base")
	dbgVérifieEgalité(Position(sSans, "scenario_null_lu_comme_valeur_par_defaut"), 0, "pas de scénario NULL sans colonne nullable")
	dbgVérifieVrai(Position(sAvec, "scenario_null_lu_comme_valeur_par_defaut") > 0, "scénario NULL avec une colonne nullable")
FIN

// Une clé texte ajoute les scénarios « clé fournie » et « clé déjà prise » (409) au repository en mémoire.
PROCEDURE scenario_cle_texte_dans_le_depot_memoire()
	sMemoire est une chaîne = EbContenuDepotMemoire(EbTestDemandeContenu("resource;Pays;--champs;code:texte*,nom:texte"))
	sTests   est une chaîne = EbContenuTestDepotMemoire(EbTestDemandeContenu("resource;Pays;--champs;code:texte*,nom:texte"))
	dbgVérifieVrai(Position(sMemoire, "ExceptionDéclenche(409, ") > 0, "409 dans le repository")
	dbgVérifieVrai(Position(sTests, "scenario_cle_deja_prise_leve_409") > 0, "scénario 409")
	dbgVérifieEgalité(Position(EbContenuDepotMemoire(EbTestDemandeContenu("resource;Client;--champs;id:entier*,nom:texte")), "409"), 0, "pas de 409 avec une clé générée")
FIN

// L'horodatage d'une migration : AAAAMMJJHHMM, ou rien si l'instant n'a pas la forme attendue.
PROCEDURE scenario_horodatage_de_migration()
	dbgVérifieEgalité(EbHorodatageMigration("2026-11-02T10:15:30Z"), "202611021015", "forme normale")
	dbgVérifieEgalité(EbHorodatageMigration(""), "", "vide")
	dbgVérifieEgalité(EbHorodatageMigration("n'importe quoi du tout"), "", "texte quelconque")
	dbgVérifieEgalité(EbHorodatageMigration("2026-11-02 10:15"), "", "sans le T")
FIN

// La migration implémente iEbMigration, crée la table en plusieurs lignes dans une chaîne multi-lignes, et défait par DROP TABLE.
PROCEDURE scenario_contenu_d_une_migration()
	oDemande   est un cEbDemandeMake = EbTestDemandeContenu("migration;CreeClients;--champs;id:entier*,nom:texte")
	sMigration est une chaîne        = EbContenuMigration(oDemande, "202611021015", "sqlite")
	dbgVérifieVrai(Position(sMigration, "cM202611021015_CreeClients est une Classe implemente iEbMigration") > 0, "classe")
	dbgVérifieVrai(Position(sMigration, "RENVOYER " + Caract(34) + "M202611021015_CreeClients" + Caract(34)) > 0, "Nom()")
	dbgVérifieVrai(Position(sMigration, "TableauAjoute(tabSql, " + Caract(96) + "CREATE TABLE " + Caract(34) + "clients" + Caract(34) + " (") > 0, "CREATE TABLE")
	dbgVérifieVrai(Position(sMigration, Caract(9) + Caract(9) + Caract(9) + Caract(34) + "id" + Caract(34) + " INTEGER PRIMARY KEY AUTOINCREMENT,") > 0, "colonne indentée")
	dbgVérifieVrai(Position(sMigration, Caract(9) + Caract(9) + ")" + Caract(96) + ")") > 0, "fin de la chaîne multi-lignes")
	dbgVérifieVrai(Position(sMigration, "DROP TABLE " + Caract(34) + "clients" + Caract(34)) > 0, "Descend()")
FIN

// Les fichiers d'une migration : le test n'existe que pour SQLite.
PROCEDURE scenario_fichiers_d_une_migration_selon_la_base()
	oDemande est un cEbDemandeMake = EbTestDemandeContenu("migration;CreeClients;--champs;id:entier*,nom:texte")
	dbgVérifieEgalité(EbListeVirgules(EbFichiersMigration(oDemande, "202611021015", "sqlite")), "database/migrations/M202611021015_CreeClients.owl, tests/integration/migrations/test_M202611021015_CreeClients.owl", "SQLite")
	dbgVérifieEgalité(EbListeVirgules(EbFichiersMigration(oDemande, "202611021015", "postgresql")), "database/migrations/M202611021015_CreeClients.owl", "PostgreSQL : pas de test")
FIN

// La page et le total : le contrat les déclare, le repository SQL les écrit avec Burin (EbListeRequete, EbListeRequeteCompte), celui en mémoire filtre et trie les valeurs des lignes (EbListeRetenus).
PROCEDURE scenario_page_et_total_du_repository()
	oDemande est un cEbDemandeMake = EbTestDemandeContenu("resource;Client;--champs;id:entier*,nom:texte")
	sContrat est une chaîne        = EbContenuContrats(oDemande)
	sSql     est une chaîne        = EbContenuDepotSql(oDemande)
	sMemoire est une chaîne        = EbContenuDepotMemoire(oDemande)
	dbgVérifieVrai(Position(sContrat, "PROCEDURE PUBLIQUE EnumerePage(criteres est un cEbCriteresListe) : tableau de cClient") > 0, "contrat : la page")
	dbgVérifieVrai(Position(sContrat, "PROCEDURE PUBLIQUE Compte(criteres est un cEbCriteresListe) : entier") > 0, "contrat : le total")
	dbgVérifieVrai(Position(sSql, "EbListeRequete(:oBurin, :oTable, criteres)") > 0, "SQL : la page par Burin")
	dbgVérifieVrai(Position(sSql, "EbListeTotal(oResultat)") > 0, "SQL : le total")
	dbgVérifieVrai(Position(sMemoire, "tabValeurs[" + Caract(34) + "nom" + Caract(34) + "] = oEntite.LitNom()") > 0, "mémoire : les valeurs de la ligne par colonne")
	dbgVérifieVrai(Position(sMemoire, "EbListeFenetre(EbListeRetenus(:ValeursDeToutes(), criteres, " + Caract(34) + "id" + Caract(34) + "), criteres)") > 0, "mémoire : filtrer, trier, découper")
FIN

// La fabrique : un générateur injecté (jamais Hasard), Cree et CreeAvec en mémoire, Persiste et PersisteAvec par le repository ; une clé entière générée par la base vaut 0 ; une valeur fixée l'emporte.
PROCEDURE scenario_fabrique_d_une_ressource()
	oDemande est un cEbDemandeMake = EbTestDemandeContenu("resource;Client;--champs;id:entier*,nom:texte,email:texte?,actif:booleen,note:reel,naissance:date?,vu:dateheure?")
	sTexte   est une chaîne        = EbContenuFabriqueRessource(oDemande)
	dbgVérifieEgalité(EbCheminFabrique(oDemande), "database/factories/client/cFabriqueClient.owl", "chemin")
	dbgVérifieVrai(Position(sTexte, "cFabriqueClient est une Classe") > 0, "classe cFabriqueClient")
	dbgVérifieVrai(Position(sTexte, "PROCEDURE Constructeur(generateur est un iEbGenerateur)") > 0, "le générateur est injecté")
	dbgVérifieVrai(Position(sTexte, "PROCEDURE PUBLIQUE Cree() : cClient") > 0, "Cree")
	dbgVérifieVrai(Position(sTexte, "PROCEDURE PUBLIQUE CreeAvec(surcharges est un tableau associatif) : cClient") > 0, "CreeAvec")
	dbgVérifieVrai(Position(sTexte, "PROCEDURE PUBLIQUE Persiste(repository est un iRepoClient) : cClient") > 0, "Persiste")
	dbgVérifieVrai(Position(sTexte, "PROCEDURE PUBLIQUE PersisteAvec(repository est un iRepoClient, surcharges est un tableau associatif) : cClient") > 0, "PersisteAvec")
	dbgVérifieVrai(Position(sTexte, "vNom est une chaîne = :oGenerateur.ValeurTexte(" + Caract(34) + "nom" + Caract(34) + ")") > 0, "texte : le nom de la colonne est donné au générateur")
	dbgVérifieVrai(Position(sTexte, "vActif est un booléen = :oGenerateur.ValeurBooleen()") > 0, "booléen")
	dbgVérifieVrai(Position(sTexte, "vNote est un réel = :oGenerateur.ValeurReel()") > 0, "réel")
	dbgVérifieVrai(Position(sTexte, "vNaissance est une chaîne = :oGenerateur.ValeurDate()") > 0, "date")
	dbgVérifieVrai(Position(sTexte, "vVu est une chaîne = :oGenerateur.ValeurDateHeure()") > 0, "date-heure")
	dbgVérifieVrai(Position(sTexte, "SI TableauCherche(surcharges, " + Caract(34) + "nom" + Caract(34) + ") > 0 ALORS") > 0, "une valeur fixée est cherchée par le nom de la colonne")
	dbgVérifieVrai(Position(sTexte, "oEntite est un cClient(0, vNom, vEmail, vActif, vNote, vNaissance, vVu)") > 0, "la clé générée vaut 0, les autres valeurs viennent des variables")
	dbgVérifieEgalité(Position(sTexte, "vId"), 0, "la clé générée n'a ni variable ni surcharge")
	dbgVérifieEgalité(Position(sTexte, "Hasard"), 0, "jamais Hasard : il n'est pas reproductible entre Windows et Linux")
	oTexteCle est un cEbDemandeMake = EbTestDemandeContenu("resource;Pays;--champs;code:texte*,nom:texte")
	sCle      est une chaîne        = EbContenuFabriqueRessource(oTexteCle)
	dbgVérifieVrai(Position(sCle, "vCode est une chaîne = :oGenerateur.ValeurTexte(" + Caract(34) + "code" + Caract(34) + ")") > 0, "une clé texte vient du générateur et peut être fixée")
	dbgVérifieVrai(Position(sCle, "oEntite est un cPays(vCode, vNom)") > 0, "clé texte : le premier argument")
FIN

// Un champ qui a une sorte (~sorte) la donne au générateur (ValeurTexteDeSorte) ; un champ sans sorte donne seulement le nom de la colonne.
PROCEDURE scenario_fabrique_avec_sorte()
	oDemande est un cEbDemandeMake = EbTestDemandeContenu("resource;Produit;--champs;id:entier*,nom:texte~produit,prenom:texte~prenom-feminin,note:texte,quantite:entier")
	sTexte   est une chaîne        = EbContenuFabriqueRessource(oDemande)
	dbgVérifieVrai(Position(sTexte, "vNom est une chaîne = :oGenerateur.ValeurTexteDeSorte(" + Caract(34) + "produit" + Caract(34) + ", " + Caract(34) + "nom" + Caract(34) + ")") > 0, "nom : la sorte produit est donnée au générateur")
	dbgVérifieVrai(Position(sTexte, "vPrenom est une chaîne = :oGenerateur.ValeurTexteDeSorte(" + Caract(34) + "prenom-feminin" + Caract(34) + ", " + Caract(34) + "prenom" + Caract(34) + ")") > 0, "prenom : la sorte prenom-feminin")
	dbgVérifieVrai(Position(sTexte, "vNote est une chaîne = :oGenerateur.ValeurTexte(" + Caract(34) + "note" + Caract(34) + ")") > 0, "note : sans sorte, le nom de la colonne seul")
	dbgVérifieVrai(Position(sTexte, "vQuantite est un entier = :oGenerateur.ValeurEntier()") > 0, "un entier ne change pas")
FIN
