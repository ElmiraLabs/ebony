	dbgVérifieEgalité(Gauche(sRefus, 3), "38|", "code 38")
	dbgVérifieVrai(Position(sRefus, "mysql") > 0, "cite le fournisseur")
	dbgVérifieEgalité(oDisque.NbFichiers(), 1, "rien d'écrit")
FIN

// Une copie d'ebony/ sans iEbMigration (projet généré avant ce contrat) : la migration est écrite, avec une note qui dit de restaurer ebony/.
PROCEDURE scenario_bibliotheque_ancienne_signalee()
	oDisque est un cEbSystemeFichiersFictif = EbTestDisqueMake("sqlite")
	oDisque.CreeDossier("C:\Projets\Mon App\ebony\donnees")
	oDisque.EcritTexte("C:\Projets\Mon App\ebony\donnees\EbContratsDonnees.owl", "EbContratsDonnees est une CollectionDeProcédures" + Caract(10) + "FIN" + Caract(10))
	oHorloge    est un cEbHorlogeFictive
	oGeneration est un cEbGenerationMake(oDisque, oDisque, oHorloge)
	oGenere     est un cEbMakeGenere                                 = oGeneration.Execute(EbTestDemandeMake("migration;CreeClients;--champs;id:entier*,nom:texte"))
	dbgVérifieVrai(Position(EbListeVirgules(oGenere.Notes()), "ebony restore") > 0, "note : restaurer ebony/")
	oDisque.EcritTexte("C:\Projets\Mon App\ebony\donnees\EbContratsDonnees.owl", "iEbMigration est une Interface" + Caract(10))
	oRecente est un cEbMakeGenere = oGeneration.Execute(EbTestDemandeMake("migration;CreeAutre;--champs;id:entier*,nom:texte"))
	dbgVérifieEgalité(Position(EbListeVirgules(oRecente.Notes()), "ebony restore"), 0, "pas de note avec une bibliothèque récente")
FIN

// Une table d'un schéma : le test SQLite généré attache d'abord une base en mémoire sous ce nom de schéma.
PROCEDURE scenario_table_avec_schema_attachee_dans_les_tests()
	oDemande est un cEbDemandeMake = EbTestDemandeMake("resource;Client;--table;crm.Clients;--champs;id:entier*,nom:texte")
	sTest    est une chaîne        = EbContenuTestDepotSql(oDemande)
	dbgVérifieVrai(Position(sTest, `ATTACH DATABASE ':memory:' AS "crm"`) > 0, "ATTACH")
	dbgVérifieVrai(Position(sTest, `CREATE TABLE "crm"."Clients"`) > 0, "table qualifiée")
	dbgVérifieEgalité(Position(EbContenuTestDepotSql(EbTestDemandeMake("resource;Client;--champs;id:entier*,nom:texte")), "ATTACH"), 0, "pas d'ATTACH sans schéma")
FIN

// Un manifeste SANS membre « routes » (un module qui ne fournit aucun garde) ne protège rien : le contrôleur est écrit OUVERT. Le cœur ne sait pas quel module protège : seul le contenu des manifestes compte.
PROCEDURE scenario_manifeste_sans_routes_ne_protege_pas()
	oDisque est un cEbSystemeFichiersFictif = EbTestDisqueMake("sqlite")
	oDisque.AjouteDossier("C:\Projets\Mon App\ebony")
	oDisque.AjouteDossier("C:\Projets\Mon App\ebony\modules")
	oDisque.AjouteFichier("C:\Projets\Mon App\ebony\modules\autre.json", `{ "nom": "autre" }`)
	oHorloge    est un cEbHorlogeFictive
	oGeneration est un cEbGenerationMake(oDisque, oDisque, oHorloge)
	oGenere     est un cEbMakeGenere                                 = oGeneration.Execute(EbTestDemandeMake("resource;Client;--champs;id:entier*,nom:texte"))
	sControleur est une chaîne                                       = oDisque.LitTexte("C:\Projets\Mon App\app\http\client\ControleurClient.owl")
	dbgVérifieVrai(Position(sControleur, "ROUTES OUVERTES") > 0, "ouvert : aucun garde")
	dbgVérifieVrai(Position(EbListeVirgules(oGenere.Notes()), "Les routes sont OUVERTES") > 0, "la note le dit")
FIN

// Le garde peut venir de n'importe quel manifeste de ebony/modules/ : ici un module qui ne s'appelle pas « auth ».
PROCEDURE scenario_le_garde_vient_de_n_importe_quel_module()
	oDisque est un cEbSystemeFichiersFictif = EbTestDisqueMake("sqlite")
	oDisque.AjouteDossier("C:\Projets\Mon App\ebony")
	oDisque.AjouteDossier("C:\Projets\Mon App\ebony\modules")
	oDisque.AjouteFichier("C:\Projets\Mon App\ebony\modules\ailleurs.json", `{ "routes": { "proprietes": [ "Authentification = httpAuthBearer" ], "procedures": [ "// Garde d'un autre module.", "PROCEDURE surAuthentification(sJeton est une chaîne) : booléen", "\tRENVOYER Vrai", "FIN" ] } }`)
	oHorloge    est un cEbHorlogeFictive
	oGeneration est un cEbGenerationMake(oDisque, oDisque, oHorloge)
	oGenere     est un cEbMakeGenere                                 = oGeneration.Execute(EbTestDemandeMake("resource;Client;--champs;id:entier*,nom:texte"))
	sControleur est une chaîne                                       = oDisque.LitTexte("C:\Projets\Mon App\app\http\client\ControleurClient.owl")
	dbgVérifieVrai(Position(sControleur, "// Garde d'un autre module.") > 0, "les lignes de cet autre module sont écrites")
	dbgVérifieEgalité(Position(sControleur, "ROUTES OUVERTES"), 0, "protégé")
FIN

// Un manifeste illisible dans le projet : erreur 22 qui le nomme, et rien n'est écrit (pas de contrôleur ouvert par défaut).
PROCEDURE scenario_manifeste_illisible_refuse()
	oDisque est un cEbSystemeFichiersFictif = EbTestDisqueMake("sqlite")
	oDisque.AjouteDossier("C:\Projets\Mon App\ebony")
	oDisque.AjouteDossier("C:\Projets\Mon App\ebony\modules")
	oDisque.AjouteFichier("C:\Projets\Mon App\ebony\modules\auth.json", "pas du json {")
	nFichiers est un entier  = oDisque.NbFichiers()
	sEchec    est une chaîne = EbTestEchecMake(oDisque, "resource;Client;--champs;id:entier*,nom:texte")
	dbgVérifieEgalité(Gauche(sEchec, 3), "22|", "code 22")
	dbgVérifieVrai(Position(sEchec, "auth.json") > 0, "le manifeste est nommé")
	dbgVérifieEgalité(oDisque.NbFichiers(), nFichiers, "rien n'a été écrit")
FIN

// Un projet avec la ressource Client déjà générée (sa fabrique) et le registre des composants : de quoi écrire un seeder.
PROCEDURE EbTestDisqueSeeder() : cEbSystemeFichiersFictif
	oDisque est un cEbSystemeFichiersFictif = EbTestDisqueMake("sqlite")
	oDisque.AjouteDossier("C:\Projets\Mon App\app")
	oDisque.AjouteFichier("C:\Projets\Mon App\app\Composants.owl", "AppMonAppComposants est une CollectionDeProcédures" + Caract(10) + Caract(9) + "PROCEDURE AppMonAppFabriques() : tableau" + Caract(10) + Caract(9) + "FIN" + Caract(10) + "FIN" + Caract(10))
	oDisque.AjouteDossier("C:\Projets\Mon App\database")
	oDisque.AjouteDossier("C:\Projets\Mon App\database\factories")
	oDisque.AjouteDossier("C:\Projets\Mon App\database\factories\client")
	oDisque.AjouteFichier("C:\Projets\Mon App\database\factories\client\cFabriqueClient.owl", "cFabriqueClient est une Classe" + Caract(10) + "FIN" + Caract(10))
	RENVOYER oDisque
FIN

// make seeder écrit la classe, son test et le lanceur (avec le registre du projet), et le dit.
PROCEDURE scenario_seeder_complet()
	oDisque     est un cEbSystemeFichiersFictif                      = EbTestDisqueSeeder()
	oHorloge    est un cEbHorlogeFictive
	oGeneration est un cEbGenerationMake(oDisque, oDisque, oHorloge)
	oDemande    est un cEbDemandeMake                                = EbTestDemandeMake("seeder;Client")
	oGenere     est un cEbMakeGenere                                 = oGeneration.Execute(oDemande)
	dbgVérifieEgalité(oGenere.NomCommande(), "make seeder", "commande")
	dbgVérifieEgalité(oGenere.Crees()..Occurrence, 3, "trois fichiers créés")
	dbgVérifieEgalité(oGenere.Conserves()..Occurrence, 0, "aucun conservé")
	dbgVérifieEgalité(oDisque.LitTexte("C:\Projets\Mon App\database\seeders\client\cSeederClient.owl"), EbAligneDeclarations(EbContenuClasseSeeder(oDemande)), "classe écrite")
	dbgVérifieEgalité(oDisque.LitTexte("C:\Projets\Mon App\tests\unitaires\client\test_cSeederClient.owl"), EbAligneDeclarations(EbContenuTestSeeder(oDemande)), "test écrit")
	sLanceur est une chaîne = oDisque.LitTexte("C:\Projets\Mon App\database\seeders\DatabaseSeeder.owl")
	dbgVérifieVrai(Position(sLanceur, "POUR TOUT oSeedComposant DE AppMonAppFabriques()") > 0, "le lanceur appelle le registre du projet")
	dbgVérifieVrai(Position(EbListeVirgules(oGenere.Notes()), "owl database/seeders/DatabaseSeeder.owl --seed") > 0, "la note dit comment lancer")
	dbgVérifieEgalité(oDisque.FichierExiste("C:\Projets\Mon App\app\http\client\ControleurClient.owl"), Faux, "aucun contrôleur : un seeder n'écrit que le sien")
FIN

// Relancé, il ne remplace rien : tout est conservé, une note par fichier.
PROCEDURE scenario_seeder_relance_ne_remplace_rien()
	oDisque     est un cEbSystemeFichiersFictif                      = EbTestDisqueSeeder()
	oHorloge    est un cEbHorlogeFictive
	oGeneration est un cEbGenerationMake(oDisque, oDisque, oHorloge)
	oGeneration.Execute(EbTestDemandeMake("seeder;Client"))
	oDisque.EcritTexte("C:\Projets\Mon App\database\seeders\client\cSeederClient.owl", "// modifié par l'utilisateur")
	oRelance est un cEbMakeGenere = oGeneration.Execute(EbTestDemandeMake("seeder;Client"))
	dbgVérifieEgalité(oRelance.Crees()..Occurrence, 0, "rien de créé")
	dbgVérifieEgalité(oRelance.Conserves()..Occurrence, 3, "trois conservés")
	dbgVérifieEgalité(oDisque.LitTexte("C:\Projets\Mon App\database\seeders\client\cSeederClient.owl"), "// modifié par l'utilisateur", "le fichier de l'utilisateur est intact")
	dbgVérifieVrai(Position(EbListeVirgules(oRelance.Notes()), "oSeedRepoClient est un cRepoClientSql") > 0, "la note donne les lignes à ajouter au lanceur conservé")
FIN

// Un seeder pour une autre ressource, avec le lanceur déjà là : le lanceur n'est pas touché.
PROCEDURE scenario_seeder_lanceur_existant_non_modifie()
	oDisque     est un cEbSystemeFichiersFictif                      = EbTestDisqueSeeder()
	oHorloge    est un cEbHorlogeFictive
	oGeneration est un cEbGenerationMake(oDisque, oDisque, oHorloge)
	oDisque.AjouteDossier("C:\Projets\Mon App\database\seeders")
	oDisque.AjouteFichier("C:\Projets\Mon App\database\seeders\DatabaseSeeder.owl", "// le lanceur de l'utilisateur")
	oGenere est un cEbMakeGenere = oGeneration.Execute(EbTestDemandeMake("seeder;Client"))
	dbgVérifieEgalité(oGenere.Crees()..Occurrence, 2, "la classe et son test")
	dbgVérifieEgalité(oGenere.Conserves()[1], "database/seeders/DatabaseSeeder.owl", "le lanceur est conservé")
	dbgVérifieEgalité(oDisque.LitTexte("C:\Projets\Mon App\database\seeders\DatabaseSeeder.owl"), "// le lanceur de l'utilisateur", "il n'est pas modifié")
FIN

// --dry-run : rien d'écrit.
PROCEDURE scenario_seeder_apercu_n_ecrit_rien()
	oDisque     est un cEbSystemeFichiersFictif                      = EbTestDisqueSeeder()
	oHorloge    est un cEbHorlogeFictive
	oGeneration est un cEbGenerationMake(oDisque, oDisque, oHorloge)
	oGenere     est un cEbMakeGenere                                 = oGeneration.Execute(EbTestDemandeMake("seeder;Client;--dry-run"))
	dbgVérifieEgalité(oGenere.Crees()..Occurrence, 3, "trois fichiers seraient créés")
	dbgVérifieEgalité(oDisque.FichierExiste("C:\Projets\Mon App\database\seeders\client\cSeederClient.owl"), Faux, "rien d'écrit")
FIN

// Sans la fabrique de la ressource (ressource absente ou fabrique supprimée), le seeder ne compilerait pas : code 32, rien d'écrit.
PROCEDURE scenario_seeder_sans_fabrique_refuse()
	oDisque est un cEbSystemeFichiersFictif = EbTestDisqueSeeder()
	sRes    est une chaîne                  = EbTestEchecMake(oDisque, "seeder;Fantome")
	dbgVérifieEgalité(Gauche(sRes, 3), "32|", "code 32")
	dbgVérifieVrai(Position(sRes, "n'a pas de fabrique") > 0, "le message dit pourquoi")
	dbgVérifieEgalité(oDisque.FichierExiste("C:\Projets\Mon App\database\seeders\DatabaseSeeder.owl"), Faux, "rien d'écrit")
FIN

// Sans registre des composants, le lanceur ne saurait pas démarrer la base : code 32.
PROCEDURE scenario_seeder_sans_registre_refuse()
	oDisque est un cEbSystemeFichiersFictif = EbTestDisqueMake("sqlite")
	oDisque.AjouteDossier("C:\Projets\Mon App\database")
	oDisque.AjouteDossier("C:\Projets\Mon App\database\factories")
	oDisque.AjouteDossier("C:\Projets\Mon App\database\factories\client")
	oDisque.AjouteFichier("C:\Projets\Mon App\database\factories\client\cFabriqueClient.owl", "cFabriqueClient est une Classe")
