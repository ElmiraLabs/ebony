FIN

// Un module du projet (son manifeste est dans ebony/modules/) qui déclare un générateur : « make seeder » l'écrit dans le lanceur à la place du compteur, et la note le dit.
PROCEDURE scenario_seeder_generateur_declare_par_un_module()
	oDisque     est un cEbSystemeFichiersFictif                      = EbTestDisqueSeeder()
	oHorloge    est un cEbHorlogeFictive
	oGeneration est un cEbGenerationMake(oDisque, oDisque, oHorloge)
	oDisque.AjouteDossier("C:\Projets\Mon App\ebony")
	oDisque.AjouteDossier("C:\Projets\Mon App\ebony\modules")
	oDisque.AjouteFichier("C:\Projets\Mon App\ebony\modules\imitateur.json", `{ "nom": "imitateur", "generateur": { "classe": "cEbGenerateurImitateur", "graine": 7 } }`)
	oGenere  est un cEbMakeGenere = oGeneration.Execute(EbTestDemandeMake("seeder;Client"))
	sLanceur est une chaîne       = oDisque.LitTexte("C:\Projets\Mon App\database\seeders\DatabaseSeeder.owl")
	dbgVérifieVrai(Position(sLanceur, "cFabriqueClient(cEbGenerateurImitateur(7))") > 0, "le lanceur utilise le générateur du module")
	dbgVérifieEgalité(Position(sLanceur, "cEbGenerateurCompteur"), 0, "et pas le compteur")
	dbgVérifieVrai(Position(EbListeVirgules(oGenere.Notes()), "cEbGenerateurImitateur(7) : un module du projet") > 0, "la note nomme le générateur")
	dbgVérifieEgalité(Position(oDisque.LitTexte("C:\Projets\Mon App\tests\unitaires\client\test_cSeederClient.owl"), "cEbGenerateurImitateur"), 0, "le test du seeder reste sur le compteur : il compile sans le module")
FIN

// Sans module qui déclare un générateur (le cas de base), le compteur ; avec deux modules qui en déclarent, le premier par ordre alphabétique l'emporte ; un membre incorrect refuse (22) sans rien écrire.
PROCEDURE scenario_seeder_generateur_defaut_premier_et_refus()
	oSans    est un cEbSystemeFichiersFictif                  = EbTestDisqueSeeder()
	oHorloge est un cEbHorlogeFictive
	oGenSans est un cEbGenerationMake(oSans, oSans, oHorloge)
	oGenSans.Execute(EbTestDemandeMake("seeder;Client"))
	dbgVérifieVrai(Position(oSans.LitTexte("C:\Projets\Mon App\database\seeders\DatabaseSeeder.owl"), "cFabriqueClient(cEbGenerateurCompteur())") > 0, "sans module : le compteur")
	oDeux est un cEbSystemeFichiersFictif = EbTestDisqueSeeder()
	oDeux.AjouteDossier("C:\Projets\Mon App\ebony")
	oDeux.AjouteDossier("C:\Projets\Mon App\ebony\modules")
	oDeux.AjouteFichier("C:\Projets\Mon App\ebony\modules\burin.json", `{ "nom": "burin" }`)
	oDeux.AjouteFichier("C:\Projets\Mon App\ebony\modules\zebre.json", `{ "nom": "zebre", "generateur": { "classe": "cEbGenerateurZebre" } }`)
	oDeux.AjouteFichier("C:\Projets\Mon App\ebony\modules\alpha.json", `{ "nom": "alpha", "generateur": { "classe": "cEbGenerateurAlpha", "graine": 1 } }`)
	oGenDeux est un cEbGenerationMake(oDeux, oDeux, oHorloge)
	oGenDeux.Execute(EbTestDemandeMake("seeder;Client"))
	dbgVérifieVrai(Position(oDeux.LitTexte("C:\Projets\Mon App\database\seeders\DatabaseSeeder.owl"), "cFabriqueClient(cEbGenerateurAlpha(1))") > 0, "deux modules : le premier par ordre alphabétique")
	oMauvais est un cEbSystemeFichiersFictif = EbTestDisqueSeeder()
	oMauvais.AjouteDossier("C:\Projets\Mon App\ebony")
	oMauvais.AjouteDossier("C:\Projets\Mon App\ebony\modules")
	oMauvais.AjouteFichier("C:\Projets\Mon App\ebony\modules\piege.json", `{ "nom": "piege", "generateur": { "classe": "cEb(); Trace(1)" } }`)
	sRes est une chaîne = EbTestEchecMake(oMauvais, "seeder;Client")
	dbgVérifieEgalité(Gauche(sRes, 3), "22|", "un membre incorrect : code 22")
	dbgVérifieEgalité(oMauvais.FichierExiste("C:\Projets\Mon App\database\seeders\DatabaseSeeder.owl"), Faux, "rien n'est écrit")
FIN
