// Tests de EbCorpsRequete : les sentinelles qui disent « absent du corps » et les valeurs d'une modification partielle (la valeur du corps ou la ligne actuelle). Que OWL applique vraiment ces valeurs aux champs absents d'un corps JSON est prouvé par tests/integration/lanceur.ps1 (groupe make2, vrai owl serve).

// Chaque sentinelle est reconnue, et une vraie valeur ne l'est pas : zéro, vide et faux sont des valeurs, pas des absences.
PROCEDURE scenario_sentinelles_reconnues()
	dbgVérifieVrai(EbTexteAbsent("__absent__"), "texte absent")
	dbgVérifieFaux(EbTexteAbsent(""), "un texte vide est une valeur")
	dbgVérifieFaux(EbTexteAbsent("nom"), "un texte est une valeur")
	dbgVérifieVrai(EbEntierAbsent(-999999999), "entier absent")
	dbgVérifieFaux(EbEntierAbsent(0), "zéro est une valeur")
	dbgVérifieFaux(EbEntierAbsent(-1), "-1 est une valeur pour un entier")
	dbgVérifieVrai(EbReelAbsent(-999999999.5), "réel absent")
	dbgVérifieFaux(EbReelAbsent(0), "zéro est une valeur")
	dbgVérifieFaux(EbReelAbsent(5.5), "5,5 est une valeur")
	dbgVérifieVrai(EbBooleenAbsent(-1), "booléen absent")
	dbgVérifieFaux(EbBooleenAbsent(0), "faux est une valeur")
	dbgVérifieFaux(EbBooleenAbsent(1), "vrai est une valeur")
FIN

// Une modification partielle : la valeur du corps si elle est présente (zéro, vide et faux compris), sinon celle de la ligne actuelle.
PROCEDURE scenario_valeurs_d_une_modification_partielle()
	dbgVérifieEgalité(EbTexteOuActuel("__absent__", "ancien"), "ancien", "texte absent : l'ancien")
	dbgVérifieEgalité(EbTexteOuActuel("nouveau", "ancien"), "nouveau", "texte présent")
	dbgVérifieEgalité(EbTexteOuActuel("", "ancien"), "", "texte vidé : c'est une valeur, elle remplace")
	dbgVérifieEgalité(EbEntierOuActuel(-999999999, 5), 5, "entier absent : l'ancien")
	dbgVérifieEgalité(EbEntierOuActuel(9, 5), 9, "entier présent")
	dbgVérifieEgalité(EbEntierOuActuel(0, 5), 0, "zéro : c'est une valeur, il remplace")
	dbgVérifieEgalité(EbReelOuActuel(-999999999.5, 1.5), 1.5, "réel absent : l'ancien")
	dbgVérifieEgalité(EbReelOuActuel(0, 1.5), 0, "zéro : une valeur")
	dbgVérifieEgalité(EbReelOuActuel(3.75, 1.5), 3.75, "réel présent")
	dbgVérifieVrai(EbBooleenOuActuel(-1, Vrai), "booléen absent : l'ancien (vrai)")
	dbgVérifieFaux(EbBooleenOuActuel(-1, Faux), "booléen absent : l'ancien (faux)")
	dbgVérifieFaux(EbBooleenOuActuel(0, Vrai), "faux : une valeur, il remplace")
	dbgVérifieVrai(EbBooleenOuActuel(1, Faux), "vrai : une valeur, il remplace")
FIN
