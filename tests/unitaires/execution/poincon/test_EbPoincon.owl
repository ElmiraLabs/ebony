// Tests de EbPoincon : le contrôle de la description lue dans ressource.json (rien n'est ignoré en silence : règle inconnue, mauvais type de valeur, champ incorrect) et les petits utilitaires de lecture.
// Les fonctions ne dépendent que du JSON passé en argument : aucun disque. La validation d'un corps (obligation, défauts, règles, 422) est testée dans test_EbPoinconValidation, test_EbPoinconRessource et test_cEbSchema ; la lecture du fichier par « owl serve » est prouvée par tests/integration/lanceur.ps1 (groupe make2).

// Une description d'un seul champ, d'après le texte JSON du champ.
PROCEDURE EbTestDescriptionPoincon(sChamp est une chaîne) : JSON
	j est un JSON
	j = ChaîneVersJSON(`{ "champs": [ ` + sChamp + ` ] }`)
	RENVOYER j
FIN

// Rend « code|message » si le contrôle de la description lève, ou « » si elle est acceptée.
PROCEDURE EbTestRefusPoincon(sChamp est une chaîne) : chaîne
	sRes est une chaîne = ""
	j    est un JSON
	j = EbTestDescriptionPoincon(sChamp)
	QUAND EXCEPTION DANS
		EbPoinconControleDescription(j, "ressource.json")
	FAIRE
		sRes = ExceptionInfo(errCode) + "|" + ExceptionInfo(errMessage)
	FIN
	RENVOYER sRes
FIN

// Une description complète et correcte, avec chaque règle du vocabulaire, est acceptée.
PROCEDURE scenario_description_correcte_acceptee()
	dbgVérifieEgalité(EbTestRefusPoincon(`{ "nom": "id", "type": "entier", "cle": true }, { "nom": "nom", "type": "texte", "regles": { "longueurMin": 2, "longueurMax": 60, "motif": "^[A-Z]" } }, { "nom": "statut", "type": "texte", "defaut": "actif", "regles": { "valeurs": ["actif", "suspendu"] } }, { "nom": "age", "type": "entier", "regles": { "min": 0, "max": 150, "valeurs": [1, 2, 3] } }, { "nom": "prix", "type": "reel", "nullable": true, "defaut": 1.5, "regles": { "min": 0, "max": 99.5 } }, { "nom": "actif", "type": "booleen", "defaut": true }, { "nom": "naissance", "type": "date", "nullable": true }, { "nom": "vu", "type": "dateheure", "nullable": true }`), "", "tout est permis")
	dbgVérifieEgalité(EbTestRefusPoincon(`{ "nom": "x", "type": "texte", "regles": {} }`), "", "des règles vides")
	dbgVérifieEgalité(EbTestRefusPoincon(`{ "nom": "x", "type": "reel", "defaut": 3 }`), "", "un entier est un défaut permis pour un réel")
FIN

// Une règle inconnue n'est JAMAIS ignorée : 500, avec le champ, la règle et les règles permises.
PROCEDURE scenario_regle_inconnue_refusee()
	sRefus est une chaîne = EbTestRefusPoincon(`{ "nom": "nom", "type": "texte", "regles": { "longueurMax": 60, "tailleMax": 3 } }`)
	dbgVérifieEgalité(Gauche(sRefus, 4), "500|", "code 500")
	dbgVérifieVrai(Position(sRefus, "ressource.json") > 0, "nomme le fichier")
	dbgVérifieVrai(Position(sRefus, "champ « nom »") > 0, "nomme le champ")
	dbgVérifieVrai(Position(sRefus, "« tailleMax »") > 0, "nomme la règle")
	dbgVérifieVrai(Position(sRefus, "règles permises : longueurMin, longueurMax, valeurs, motif") > 0, "dit les règles permises")
FIN

// Une règle d'un autre type est refusée aussi : longueurMax ne s'applique pas à un entier, min ne s'applique pas à un texte, aucune règle ne s'applique à un booléen ni à une date.
PROCEDURE scenario_regle_d_un_autre_type_refusee()
	dbgVérifieVrai(Position(EbTestRefusPoincon(`{ "nom": "n", "type": "entier", "regles": { "longueurMax": 3 } }`), "« longueurMax »") > 0, "longueurMax sur un entier")
	dbgVérifieVrai(Position(EbTestRefusPoincon(`{ "nom": "n", "type": "texte", "regles": { "min": 3 } }`), "« min »") > 0, "min sur un texte")
	dbgVérifieVrai(Position(EbTestRefusPoincon(`{ "nom": "n", "type": "reel", "regles": { "valeurs": [1] } }`), "« valeurs »") > 0, "valeurs sur un réel")
	dbgVérifieVrai(Position(EbTestRefusPoincon(`{ "nom": "n", "type": "booleen", "regles": { "min": 0 } }`), "aucune règle ne s'applique à ce type") > 0, "booléen")
	dbgVérifieVrai(Position(EbTestRefusPoincon(`{ "nom": "n", "type": "date", "regles": { "motif": "x" } }`), "aucune règle ne s'applique à ce type") > 0, "date")
FIN

// Une valeur de règle du mauvais type, vide ou incohérente est refusée.
PROCEDURE scenario_valeur_de_regle_incorrecte_refusee()
	dbgVérifieVrai(Position(EbTestRefusPoincon(`{ "nom": "n", "type": "texte", "regles": { "longueurMax": "soixante" } }`), "doit être un entier") > 0, "longueur en texte")
	dbgVérifieVrai(Position(EbTestRefusPoincon(`{ "nom": "n", "type": "texte", "regles": { "longueurMax": 2.5 } }`), "doit être un entier") > 0, "longueur décimale")
	dbgVérifieVrai(Position(EbTestRefusPoincon(`{ "nom": "n", "type": "entier", "regles": { "min": "zéro" } }`), "doit être un nombre") > 0, "borne en texte")
	dbgVérifieVrai(Position(EbTestRefusPoincon(`{ "nom": "n", "type": "texte", "regles": { "motif": 5 } }`), "« motif » doit être un texte") > 0, "motif qui n'est pas un texte")
	dbgVérifieVrai(Position(EbTestRefusPoincon(`{ "nom": "n", "type": "texte", "regles": { "valeurs": "a" } }`), "« valeurs » doit être une liste") > 0, "valeurs qui n'est pas une liste")
	dbgVérifieVrai(Position(EbTestRefusPoincon(`{ "nom": "n", "type": "texte", "regles": { "valeurs": [] } }`), "ne peut pas être vide") > 0, "valeurs vide")
	dbgVérifieVrai(Position(EbTestRefusPoincon(`{ "nom": "n", "type": "texte", "regles": { "valeurs": [1, 2] } }`), "sont des textes") > 0, "valeurs d'un texte : des textes")
	dbgVérifieVrai(Position(EbTestRefusPoincon(`{ "nom": "n", "type": "entier", "regles": { "valeurs": ["a"] } }`), "sont des entiers") > 0, "valeurs d'un entier : des entiers")
	dbgVérifieVrai(Position(EbTestRefusPoincon(`{ "nom": "n", "type": "texte", "regles": { "longueurMin": 9, "longueurMax": 3 } }`), "longueurMin (9) dépasse longueurMax (3)") > 0, "longueurs incohérentes")
	dbgVérifieVrai(Position(EbTestRefusPoincon(`{ "nom": "n", "type": "reel", "regles": { "min": 10, "max": 5.5 } }`), "min dépasse max") > 0, "bornes incohérentes")
	dbgVérifieVrai(Position(EbTestRefusPoincon(`{ "nom": "n", "type": "texte", "regles": [1] }`), "« regles » du champ « n » doit être un objet") > 0, "regles qui n'est pas un objet")
FIN

// Le nom, le type et le défaut d'un champ sont contrôlés aussi.
PROCEDURE scenario_champ_incorrect_refuse()
	dbgVérifieVrai(Position(EbTestRefusPoincon(`{ "type": "texte" }`), "n'a pas de « nom »") > 0, "sans nom")
	dbgVérifieVrai(Position(EbTestRefusPoincon(`{ "nom": "n" }`), "type absent ou inconnu") > 0, "sans type")
	dbgVérifieVrai(Position(EbTestRefusPoincon(`{ "nom": "n", "type": "uuid" }`), "type absent ou inconnu (« uuid »)") > 0, "type inconnu")
	dbgVérifieVrai(Position(EbTestRefusPoincon(`{ "nom": "n", "type": "entier", "defaut": "trois" }`), "le « defaut » du champ « n » ne convient pas à son type (entier)") > 0, "défaut d'un autre type")
	dbgVérifieVrai(Position(EbTestRefusPoincon(`{ "nom": "n", "type": "booleen", "defaut": 1 }`), "ne convient pas") > 0, "un booléen n'a pas pour défaut 1")
	dbgVérifieVrai(Position(EbTestRefusPoincon(`{ "nom": "n", "type": "texte", "defaut": 5 }`), "ne convient pas") > 0, "un texte n'a pas pour défaut un nombre")
	j est un JSON
	j = ChaîneVersJSON(`{ "table": "x" }`)
	sRefus est une chaîne = ""
	QUAND EXCEPTION DANS
		EbPoinconControleDescription(j, "ressource.json")
	FAIRE
		sRefus = ExceptionInfo(errMessage)
	FIN
	dbgVérifieVrai(Position(sRefus, "il manque « champs »") > 0, "sans champs")
FIN

// Les utilitaires de lecture : un booléen JSON vrai (faux s'il manque ou n'est pas un booléen), un nombre écrit comme dans le fichier, la nature d'un nombre.
PROCEDURE scenario_utilitaires_de_lecture()
	j est un JSON = ChaîneVersJSON(`{ "oui": true, "non": false, "texte": "true", "entier": 150, "reel": 99.5, "mot": "abc" }`)
	dbgVérifieVrai(EbPoinconVrai(j, "oui"), "vrai")
	dbgVérifieVrai(PAS EbPoinconVrai(j, "non"), "faux")
	dbgVérifieVrai(PAS EbPoinconVrai(j, "texte"), "un texte n'est pas un booléen")
	dbgVérifieVrai(PAS EbPoinconVrai(j, "absent"), "un membre absent n'est pas vrai")
	dbgVérifieEgalité(EbPoinconTexteNombre(j["entier"]), "150", "un entier s'écrit sans décimale")
	dbgVérifieEgalité(EbPoinconTexteNombre(j["reel"]), "99.5", "un réel s'écrit comme dans le fichier")
	dbgVérifieVrai(EbPoinconEstNombre(j["entier"]), "un entier est un nombre")
	dbgVérifieVrai(EbPoinconEstNombre(j["reel"]), "un réel est un nombre")
	dbgVérifieVrai(PAS EbPoinconEstNombre(j["mot"]), "un texte n'est pas un nombre")
FIN
