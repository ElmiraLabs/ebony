// « ebony make resource|migration » : écrit dans le projet du dossier COURANT les fichiers d'une ressource (entité, repositories, tests) ou d'une migration (voir EbContenuRessource et EbContenuMigration).
// NE REMPLACE JAMAIS UN FICHIER : un fichier qui existe est conservé tel quel et listé (« kept »), les autres sont créés ; le résultat dit les deux, avec une note par fichier conservé.
// Tout est calculé et vérifié AVANT la première écriture. Un chemin occupé par un DOSSIER, ou dont un dossier parent est un FICHIER, est un conflit : rien n'est écrit, tous les conflits sont listés.
// Une migration sans --champs lit les champs de la description app/domaine/<dossier>/ressource.json de la ressource qui porte sa table (ChampsDeLaDescription).
// Avec --dry-run, le résultat est le même (« created » = ce qui serait créé) mais le disque n'est pas touché.
// Règles du projet : un ebony.conf dans le dossier courant (pas de remontée), qui dit la base (base.fournisseur). Ne connaît que les ports iEbSystemeFichiers, iEbEcritureFichiers et iEbHorloge : se teste avec un faux disque.
// Chaque erreur est une exception de code : 24 écriture interrompue, 28 conflit, 29 horloge illisible, 30 OWL mal placé, 31 pas un projet ebony, 38 ebony.conf sans base, 39 HFSQL pas pris en charge pour une migration.
cEbGenerationMake est une Classe
PRIVÉ
	oSysteme  est un iEbSystemeFichiers
	oEcriture est un iEbEcritureFichiers
	oHorloge  est un iEbHorloge

	PROCEDURE Constructeur(systeme est un iEbSystemeFichiers, ecriture est un iEbEcritureFichiers, horloge est un iEbHorloge)
		:oSysteme = systeme
		:oEcriture = ecriture
		:oHorloge = horloge
	FIN

	// Le chemin complet d'un chemin relatif du projet (« app/domaine/x.owl »).
	PROCEDURE PRIVÉE Complet(lancement est une chaîne, relatif est une chaîne) : chaîne
		RENVOYER EbJointChemin(lancement, Remplace(relatif, "/", "\"))
	FIN

	// Le générateur de valeurs des seeders : celui que déclare le manifeste d'un module du projet (membre « generateur » de ebony/modules/*.json, par ordre alphabétique : le premier qui en déclare un l'emporte), sinon le compteur de Burin.
	// Lève (22) si un manifeste est illisible ou son membre « generateur » incorrect. Comme le garde des routes, c'est une donnée : l'outillage ne connaît le nom d'aucun module.
	PROCEDURE PRIVÉE LitGenerateur(lancement est une chaîne) : chaîne
		sGenerateur est une chaîne = ""
		sDossier    est une chaîne = :Complet(lancement, EbDossierManifestesProjet())
		POUR TOUT sNom DE :oSysteme.ListeFichiers(sDossier)
			SI sGenerateur = "" ET Droite(Minuscule(sNom), 5) = ".json" ALORS
				sManifeste est une chaîne = EbJointChemin(sDossier, sNom)
				sGenerateur = EbGenerateurDuManifeste(:oSysteme.LitTexte(sManifeste), sManifeste)
			FIN
		FIN
		SI sGenerateur = "" ALORS
			RENVOYER EbGenerateurParDefaut()
		FIN
		RENVOYER sGenerateur
	FIN

	// Les champs d'une migration lancée SANS --champs : ceux de la ressource dont la description (app/domaine/<dossier>/ressource.json, écrite par « make resource ») porte cette table.
	// Lève (25) s'il n'y en a aucune ou plusieurs (« --champs » tranche), ou si la description est incorrecte (EbChampsDeDescription).
	PROCEDURE PRIVÉE ChampsDeLaDescription(sLancement est une chaîne, sTable est une chaîne) : tableau de cEbChampTable
		sDomaine      est une chaîne            = :Complet(sLancement, "app/domaine")
		tabTrouvees   est un tableau de chaînes
		tabIllisibles est un tableau de chaînes
		sTexteTrouve  est une chaîne            = ""
		sRelatif      est une chaîne            = ""
		sChemin       est une chaîne            = ""
		sTexte        est une chaîne            = ""
		sTableLue     est une chaîne            = ""
		POUR TOUT sDossier DE :oSysteme.ListeDossiers(sDomaine)
			sRelatif = "app/domaine/" + sDossier + "/ressource.json"
			sChemin  = :Complet(sLancement, sRelatif)
			SI :oSysteme.FichierExiste(sChemin) ALORS
				sTexte    = :oSysteme.LitTexte(sChemin)
				sTableLue = EbTableDeDescription(sTexte)
				SI sTableLue = sTable ALORS
					TableauAjoute(tabTrouvees, sRelatif)
					sTexteTrouve = sTexte
				FIN
				SI sTableLue = "" ALORS
					TableauAjoute(tabIllisibles, sRelatif)
				FIN
			FIN
		FIN
		SI tabTrouvees..Occurrence = 0 ALORS
			sIllisibles est une chaîne = ""
			SI tabIllisibles..Occurrence > 0 ALORS
				sIllisibles = " Ces fichiers n'ont pas pu être lus (JSON invalide ou sans « table ») : " + EbListeVirgules(tabIllisibles) + "."
			FIN
			ExceptionDéclenche(25, "Il manque --champs : aucune ressource décrite (app/domaine/*/ressource.json) ne porte la table « " + sTable + " ». Écrivez les champs avec --champs, ou lancez d'abord « ebony make resource <Nom> --champs … », qui écrit la description." + sIllisibles)
		FIN
		SI tabTrouvees..Occurrence > 1 ALORS
			ExceptionDéclenche(25, "Plusieurs descriptions portent la table « " + sTable + " » : " + EbListeVirgules(tabTrouvees) + ". Écrivez les champs avec --champs.")
		FIN
		tabChamps est un tableau de cEbChampTable = EbChampsDeDescription(sTexteTrouve, tabTrouvees[1])
		RENVOYER tabChamps
	FIN
	// Le premier élément du chemin relatif qui fait obstacle : un dossier à la place du fichier, ou un fichier à la place d'un dossier parent. « » si rien ne gêne.
	PROCEDURE PRIVÉE Obstacle(lancement est une chaîne, relatif est une chaîne) : chaîne
		tabParties est un tableau de chaînes = ChaîneDécoupe(relatif, "/")
		sCourant   est une chaîne            = ""
		nNb        est un entier             = tabParties..Occurrence
		POUR i = 1 À nNb
			SI sCourant <> "" ALORS
				sCourant += "/"
			FIN
			sCourant += tabParties[i]
			sComplet est une chaîne = :Complet(lancement, sCourant)
			SI i < nNb ALORS
				SI :oSysteme.FichierExiste(sComplet) ALORS
					RENVOYER sCourant + " (un fichier porte ce nom, il devrait être un dossier)"
				FIN
			SINON
				SI :oSysteme.DossierExiste(sComplet) ALORS
					RENVOYER sCourant + " (un dossier porte ce nom)"
				FIN
			FIN
		FIN
		RENVOYER ""
	FIN

	PROCEDURE PUBLIQUE Execute(demande est un cEbDemandeMake) : cEbMakeGenere
		sLancement est une chaîne = :oSysteme.DossierDeLancement()
		SI PAS EbMemeChemin(sLancement, :oSysteme.DossierActif()) ALORS
			ExceptionDéclenche(30, "owl ne travaille pas dans " + sLancement + " : les fichiers seraient écrits au mauvais endroit. Lancez « ebony doctor » pour voir pourquoi.")
		FIN
		sConf est une chaîne = EbJointChemin(sLancement, "ebony.conf")
		SI PAS :oSysteme.FichierExiste(sConf) ALORS
			ExceptionDéclenche(31, "Ce dossier n'est pas un projet ebony : ebony.conf est introuvable dans " + sLancement + ". Placez-vous dans le dossier d'un projet, ou créez-en un avec « ebony new <nom> ».")
		FIN
		sTexteConf est une chaîne = :oSysteme.LitTexte(sConf)
		EbExigeModuleDuProjet(sTexteConf, "burin", "ebony make " + demande.SousCommande())
		// Le contrôleur d'une ressource appelle le Poinçon (module poincon, sans lien avec la base) : sans lui il ne compilerait pas.
		SI demande.SousCommande() = "resource" ALORS
			EbExigeModuleDuProjet(sTexteConf, "poincon", "ebony make resource")
		FIN
		sBase est une chaîne = EbBaseDeLaConf(sTexteConf)
		SI PAS EbValeurDansListe(sBase, "sqlite|postgresql|hfsql") ALORS
			ExceptionDéclenche(38, "ebony.conf n'indique pas une base connue (base.fournisseur : « " + sBase + " » ; attendu : sqlite, postgresql ou hfsql). Corrigez-le, ou recréez le projet avec « ebony new ».")
		FIN
		bMigration est un booléen = (demande.SousCommande() = "migration")
		SI bMigration ET sBase = "hfsql" ALORS
			ExceptionDéclenche(39, "« ebony make migration » n'écrit pas encore de SQL pour HFSQL (non mesuré). Bases prises en charge : sqlite, postgresql.")
		FIN
		bSeeder est un booléen = (demande.SousCommande() = "seeder")
		SI PAS bMigration ET PAS EbDialecteExiste(sBase) ALORS
			ExceptionDéclenche(39, "« ebony make " + demande.SousCommande() + " » écrit le repository avec Burin, qui n'a pas encore de dialecte SQL pour " + sBase + " (non mesuré). Bases prises en charge : sqlite, postgresql.")
		FIN
		// Un seeder s'appuie sur la ressource déjà générée : sans sa fabrique il ne compilerait pas.
		SI bSeeder ET PAS :oSysteme.FichierExiste(:Complet(sLancement, EbCheminFabrique(demande))) ALORS
			ExceptionDéclenche(32, "La ressource « " + demande.Nom() + " » n'a pas de fabrique (" + EbCheminFabrique(demande) + " est introuvable). Générez d'abord la ressource avec « ebony make resource " + demande.Nom() + " --champs … », puis relancez cette commande.")
		FIN
		// Une migration lancée sans --champs prend ceux de la description de la ressource. Déclaré avant le SI : une déclaration dans une branche non exécutée a corrompu des variables locales en OWL 1.6.0.
		oSource    est un cEbDemandeMake           = demande
		tabDecrits est un tableau de cEbChampTable
		SI bMigration ET demande.Champs()..Occurrence = 0 ALORS
			tabDecrits = :ChampsDeLaDescription(sLancement, demande.NomTable())
			oSource    = demande.AvecChamps(tabDecrits)
		FIN
		// Le garde des routes : celui que fournissent les manifestes des modules du projet. Sans garde, le contrôleur est généré OUVERT, et une note le dit (EbSortieMake).
		oDemande est un cEbDemandeMake = oSource.AvecGarde(EbGardeRoutesDuProjet(:oSysteme, sLancement))

		// Tout ce qu'on écrira, avec son contenu, calculé avant de toucher au disque.
		tabFichiers est un tableau de chaînes
		tabContenus est un tableau de chaînes
		tabTous     est un tableau de chaînes
		// Un contrôleur déjà écrit qui n'appelle pas EbPoinconValide (écrit avant la validation du corps brut) ne lit pas le schéma du fichier du corps : ebony n'écrit alors PAS ce fichier à côté (il resterait inutilisé) et le dit.
		// Déclaré avant les SI (voir plus bas : une déclaration dans une branche non exécutée corrompt des variables locales).
		sControleur  est une chaîne = EbCheminRoutes(oDemande)
		sTexteAncien est une chaîne = ""
		bAncien      est un booléen = Faux
		SI PAS bMigration ET PAS bSeeder ET :oSysteme.FichierExiste(:Complet(sLancement, sControleur)) ALORS
			sTexteAncien = :oSysteme.LitTexte(:Complet(sLancement, sControleur))
			bAncien      = Position(sTexteAncien, "EbPoinconValide") = 0
		FIN
		sHorodatage est une chaîne = ""
		// Le registre des composants du projet (le lanceur des seeders l'appelle) : lu dans app/Composants.owl. Déclaré avant le SI (voir plus haut).
		sRegistre   est une chaîne = ""
		sComposants est une chaîne = EbJointChemin(sLancement, "app\Composants.owl")
		// Le générateur de valeurs du lanceur des seeders : celui d'un module du projet (manifeste), sinon le compteur.
		sGenerateur est une chaîne = EbGenerateurParDefaut()
		SI bSeeder ALORS
			sGenerateur = :LitGenerateur(sLancement)
		FIN
		SI bSeeder ET :oSysteme.FichierExiste(sComposants) ALORS
			sRegistre = EbNomRegistreDuProjet(:oSysteme.LitTexte(sComposants))
		FIN
		SI bSeeder ET sRegistre = "" ALORS
			ExceptionDéclenche(32, "Le registre des composants du projet est introuvable : app/Composants.owl n'existe pas ou n'a pas de procédure « …ComposantsDeclares() » (ni « …Fabriques() » pour un projet de la 0.1.5 ou avant). Le lanceur des seeders en a besoin pour démarrer la base.")
		FIN
		SI bSeeder ALORS
			tabFichiers = EbFichiersSeeder(oDemande)
			POUR i = 1 À tabFichiers..Occurrence
				TableauAjoute(tabContenus, EbContenuFichierSeeder(oDemande, sRegistre, sGenerateur, i))
			FIN
		SINON
			SI bMigration ALORS
				sHorodatage = EbHorodatageMigration(:oHorloge.Maintenant())
				SI sHorodatage = "" ALORS
					ExceptionDéclenche(29, "L'horloge a rendu un instant illisible (« " + :oHorloge.Maintenant() + " ») : impossible de dater la migration.")
				FIN
				tabFichiers = EbFichiersMigration(oSource, sHorodatage, sBase)
				POUR i = 1 À tabFichiers..Occurrence
					TableauAjoute(tabContenus, EbContenuFichierMigration(oSource, sHorodatage, sBase, i))
				FIN
			SINON
				tabTous = EbFichiersRessource(oDemande)
				POUR i = 1 À tabTous..Occurrence
					SI PAS (bAncien ET tabTous[i] = EbCheminCorps(oDemande)) ALORS
						TableauAjoute(tabFichiers, tabTous[i])
						TableauAjoute(tabContenus, EbContenuFichierRessource(oDemande, i))
					FIN
				FIN
			FIN
		FIN

		// Conflits : tous listés d'un coup, avant la moindre écriture.
		sConflits est une chaîne = ""
		POUR TOUT sRelatif DE tabFichiers
			sObstacle est une chaîne = :Obstacle(sLancement, sRelatif)
			SI sObstacle <> "" ALORS
				sConflits += EbSeparateur(sConflits) + sObstacle
			FIN
		FIN
		SI sConflits <> "" ALORS
			ExceptionDéclenche(28, "Rien n'a été écrit. Ces chemins sont occupés autrement que par le fichier attendu, et ebony ne remplace rien : " + sConflits + ". Renommez-les ou déplacez-les, puis relancez la commande.")
		FIN

		// Créés ou conservés : un fichier qui existe n'est jamais remplacé.
		tabCrees          est un tableau de chaînes
		tabConserves      est un tableau de chaînes
		tabACreer         est un tableau de chaînes
		tabContenusACreer est un tableau de chaînes
		POUR i = 1 À tabFichiers..Occurrence
			SI :oSysteme.FichierExiste(:Complet(sLancement, tabFichiers[i])) ALORS
				TableauAjoute(tabConserves, tabFichiers[i])
			SINON
				TableauAjoute(tabCrees, tabFichiers[i])
				TableauAjoute(tabACreer, tabFichiers[i])
				TableauAjoute(tabContenusACreer, tabContenus[i])
			FIN
		FIN

		// Déclaré avant le SI : une déclaration dans une branche non exécutée (--dry-run) a corrompu des variables locales en OWL 1.6.0 (le cas du SELON est le même).
		sComplet est une chaîne = ""
		SI PAS demande.Simulation() ALORS
			QUAND EXCEPTION DANS
				POUR i = 1 À tabACreer..Occurrence
					sComplet = :Complet(sLancement, tabACreer[i])
					:oEcriture.CreeDossier(EbParentChemin(sComplet))
					:oEcriture.EcritTexte(sComplet, EbAligneSiOwl(sComplet, tabContenusACreer[i]))
				FIN
			FAIRE
				ExceptionDéclenche(24, "Génération interrompue : " + ExceptionInfo(errMessage) + ". Vos fichiers n'ont pas été touchés ; ebony a pu écrire une partie de ce qu'il crée (" + EbListeVirgules(tabCrees) + "). Supprimez-les, puis relancez la commande.")
			FIN
		FIN

		// Un seeder a ses propres notes (la ressource et son contrôleur ne sont pas écrits ici ; EbNotesMake lit les champs de la ressource, qu'un seeder n'a pas).
		tabNotes     est un tableau de chaînes
		sSchemaEnv   est une chaîne            = ""
		sEbSeedCopie est une chaîne            = EbJointChemin(sLancement, "ebony\fabriques\EbSeed.owl")
		sFichierEnv  est une chaîne            = EbJointChemin(sLancement, "config\env.json")
		SI bSeeder ET :oSysteme.FichierExiste(sFichierEnv) ALORS
			sSchemaEnv = :oSysteme.LitTexte(sFichierEnv)
		FIN
		SI bSeeder ALORS
			tabNotes = EbNotesSeeder(oDemande, tabCrees, tabConserves, sSchemaEnv, :oSysteme.FichierExiste(sFichierEnv), :oSysteme.DossierExiste(EbJointChemin(sLancement, "ebony")) ET PAS :oSysteme.FichierExiste(sEbSeedCopie), sGenerateur)
		SINON
			tabNotes = EbNotesMake(oDemande, sBase, tabConserves)
		FIN
		// Un projet généré avant iEbMigration a une copie d'ebony/ sans ce contrat (la version de la bibliothèque n'a pas changé, « upgrade » la dit alignée) : la migration ne compilerait pas.
		sContrats est une chaîne = EbJointChemin(sLancement, "ebony\donnees\EbContratsDonnees.owl")
		SI bMigration ET :oSysteme.FichierExiste(sContrats) ALORS
			SI Position(:oSysteme.LitTexte(sContrats), "iEbMigration") = 0 ALORS
				TableauAjoute(tabNotes, "La copie d'ebony/ de ce projet est plus ancienne que cette migration (iEbMigration y est absent) : elle ne compilera pas. Supprimez le dossier ebony/ à la main, puis lancez « ebony restore ».")
			FIN
		FIN
		// Un projet généré avant la dernière aide de la bibliothèque (cEbGenerateurCompteur : la fabrique) a une copie de la bibliothèque sans ce que le contrôleur appelle : il ne compilerait pas.
		sCorps est une chaîne = EbJointChemin(sLancement, "ebony\fabriques\cEbGenerateurCompteur.owl")
		SI PAS bMigration ET PAS bSeeder ET :oSysteme.DossierExiste(EbJointChemin(sLancement, "ebony")) ET PAS :oSysteme.FichierExiste(sCorps) ALORS
			TableauAjoute(tabNotes, "La copie d'ebony/ de ce projet est plus ancienne que ce contrôleur (ebony/fabriques/cEbGenerateurCompteur.owl est absent) : il ne compilera pas. Supprimez le dossier ebony/ à la main, puis lancez « ebony restore ».")
		FIN
		// Un contrôleur conservé qui n'appelle pas EbPoinconValide (écrit avant la validation du corps brut) appelle des fonctions de contrôle retirées de la bibliothèque (structure à sentinelles, EbPoinconTexte…) : il ne compile plus avec la bibliothèque à jour. Ebony ne le remplace jamais : il le dit.
		SI bAncien ET sTexteAncien <> "" ALORS
			TableauAjoute(tabNotes, sControleur + " a été écrit avant la validation du corps brut : il appelle des fonctions de contrôle que la bibliothèque ne contient plus (EbPoinconTexte, EbTexteAbsent…) et ne compile pas avec la bibliothèque à jour, et ebony n'a PAS écrit " + EbCheminCorps(oDemande) + " à côté (ce contrôleur ne l'utilise pas). Pour adopter le nouveau contrôle : copiez vos modifications ailleurs, supprimez ce fichier, relancez la même commande, puis reportez vos modifications.")
		FIN sCommande est une chaîne = "make resource"
		SI bMigration ALORS
			sCommande = "make migration"
		FIN
		SI bSeeder ALORS
			sCommande = "make seeder"
		FIN
		oGenere est un cEbMakeGenere(sCommande, demande.Nom(), demande.NomTable(), sLancement, demande.Simulation(), tabCrees, tabConserves, tabNotes)
		RENVOYER oGenere
	FIN
FIN
