// Le contrôleur d'une ressource (app/http/<dossier>/Controleur<Nom>.owl) : un ServiceREST à part, qui expose le service en six routes (liste, lecture, création, remplacement PUT, modification partielle PATCH, suppression). Fonctions pures, testées dans tests/unitaires/commandes/make/.
// POURQUOI UN CONTRÔLEUR À PART : « owl serve » monte tous les ServiceREST du projet (mesuré, owl 1.7.0) ; ajouter une ressource n'oblige donc pas à modifier le ServiceREST de l'application.
// Le contrôleur n'est pas écrit quand un nom de colonne ne peut pas être un membre de la structure du corps (voir EbChampsSansRoutes) : OWL ignore en silence 58 mots réservés comme noms de membre.
EbContenuRoutes est une CollectionDeProcédures

	// Vrai si le slug d'une colonne ne peut pas servir de membre à la structure du corps : vide, ne commençant pas par une lettre minuscule sans accent, ou mot réservé d'OWL (voir EbMotsOwl).
	PROCEDURE EbMembreCorpsRefuse(sSlug est une chaîne) : booléen
		SI sSlug = "" ALORS
			RENVOYER Vrai
		FIN
		sPremier est une chaîne = Gauche(sSlug, 1)
		SI sPremier < "a" OU sPremier > "z" ALORS
			RENVOYER Vrai
		FIN
		RENVOYER EbEstMotReserveOwl(sSlug)
	FIN

	// Le nom du membre de la structure du corps pour une colonne : le slug avec une majuscule initiale (date_naissance → Date_naissance). OWL lie le JSON sans tenir compte de la casse (mesuré, owl 1.7.0 : « nom » remplit « Nom »),
	// et « owl fmt » renomme en silence certains membres écrits en minuscules (stCorps.nom devient stCorps.Nom, stCorps.actif non) : avec la majuscule, le texte écrit par ebony est déjà celui que le formateur rend.
	// Exception (constatée sur 1 068 mots essayés avec owl fmt 1.7.0) : « owl fmt » écrit en minuscules les noms de types, écrits ici en tête de membre : date, dateheure, heure, uuid. Ces quatre-là, acceptés comme membres, restent en minuscules.
	PROCEDURE EbMembreCorps(oChamp est un cEbChampTable) : chaîne
		sSlug est une chaîne = oChamp.Slug()
		SI Position("|date|dateheure|heure|uuid|", "|" + sSlug + "|") > 0 ALORS
			RENVOYER sSlug
		FIN
		RENVOYER Majuscule(Gauche(sSlug, 1)) + Milieu(sSlug, 2)
	FIN

	// Les champs que porte le corps d'une création ou d'une modification : tous, sauf la clé quand la base la génère (elle vient alors de l'adresse).
	PROCEDURE EbChampsCorps(oDemande est un cEbDemandeMake) : tableau de cEbChampTable
		tabChamps est un tableau de cEbChampTable
		POUR TOUT oChamp DE oDemande.Champs()
			SI PAS EbCleGeneree(oChamp) ALORS
				TableauAjoute(tabChamps, oChamp)
			FIN
		FIN
		RENVOYER tabChamps
	FIN

	// Les colonnes (leur nom) dont le slug ne peut pas être un membre du corps. Une liste vide : les routes sont écrites.
	PROCEDURE EbChampsSansRoutes(oDemande est un cEbDemandeMake) : tableau de chaînes
		tabRefus est un tableau de chaînes
		POUR TOUT oChamp DE EbChampsCorps(oDemande)
			SI EbMembreCorpsRefuse(oChamp.Slug()) ALORS
				TableauAjoute(tabRefus, oChamp.NomColonne())
			FIN
		FIN
		RENVOYER tabRefus
	FIN

	// Le segment d'adresse de la ressource : la dernière partie du nom de la table, en minuscules (« crm.Clients » donne « clients »).
	PROCEDURE EbSegmentRoutes(oDemande est un cEbDemandeMake) : chaîne
		tabParties est un tableau de chaînes = ChaîneDécoupe(oDemande.NomTable(), ".")
		RENVOYER Minuscule(tabParties[tabParties..Occurrence])
	FIN

	// Le chemin du fichier de routes, relatif au projet.
	PROCEDURE EbCheminRoutes(oDemande est un cEbDemandeMake) : chaîne
		RENVOYER "app/http/" + oDemande.Dossier() + "/Controleur" + oDemande.Pascal() + ".owl"
	FIN

	// ---- Le corps : validé AVANT d'être lu (ebony/poincon/) ----

	// Le type du membre de la structure du corps : celui du champ (un booléen est un booléen). La structure ne porte AUCUNE valeur sentinelle : le contrôle se fait sur le texte reçu, qui dit ce qui a été envoyé.
	PROCEDURE EbTypeMembreCorps(oChamp est un cEbChampTable) : chaîne
		RENVOYER EbArticleTypeOwl(oChamp.TypeOwl())
	FIN

	// La valeur du champ pour une ligne COMPLÈTE : celle du corps validé (un champ absent y vaut le défaut de ressource.json, sinon celui du type : ebony n'écrit jamais NULL).
	PROCEDURE EbValeurCorps(oChamp est un cEbChampTable) : chaîne
		RENVOYER "stCorps." + EbMembreCorps(oChamp)
	FIN

	// Le nom de la variable qui porte, dans une modification PARTIELLE, la valeur finale d'un champ (celle du corps s'il a été envoyé, sinon celle de la ligne actuelle).
	PROCEDURE EbVariablePartielle(oChamp est un cEbChampTable) : chaîne
		RENVOYER "v" + EbMembreCorps(oChamp)
	FIN

	// Les colonnes qui ne sont PAS dans le corps, séparées par « | » : à la création la clé générée par la base, sinon (remplacement ou modification) la clé, qui vient de l'adresse.
	PROCEDURE EbExclusionsCorps(oDemande est un cEbDemandeMake, bCreation est un booléen) : chaîne
		sRes est une chaîne = ""
		POUR TOUT oChamp DE oDemande.Champs()
			SI (bCreation ET EbCleGeneree(oChamp)) OU (PAS bCreation ET oChamp.Cle()) ALORS
				SI sRes <> "" ALORS
					sRes += "|"
				FIN
				sRes += oChamp.NomColonne()
			FIN
		FIN
		RENVOYER sRes
	FIN

	// La table « colonne=clé|colonne=clé » des colonnes dont la clé JSON (le slug : date_naissance) n'est pas le nom de la colonne (« date naissance ») : le schéma cherche le corps sous la clé JSON. Vide si toutes les colonnes sont leur propre clé.
	PROCEDURE EbClesCorps(oDemande est un cEbDemandeMake) : chaîne
		sRes est une chaîne = ""
		POUR TOUT oChamp DE oDemande.Champs()
			SI oChamp.NomColonne() <> oChamp.Slug() ALORS
				SI sRes <> "" ALORS
					sRes += "|"
				FIN
				sRes += oChamp.NomColonne() + "=" + oChamp.Slug()
			FIN
		FIN
		RENVOYER sRes
	FIN

	// La ligne qui déclare le MODÈLE du corps : une variable de la structure du contrôleur, que le schéma garde (Cible) pour savoir quel type rendre. Elle est déclarée DANS le contrôleur, pas dans le fichier du corps : une structure déclarée dans une Collection perd en silence 20 noms de membres
	// (date, heure, etat, table, libelle, duree, liste… : OWL 1.9.0), alors que celle d'un ServiceREST les garde jusque dans JSONDésérialise.
	PROCEDURE EbLigneModele(oDemande est un cEbDemandeMake) : chaîne
		RENVOYER "stModele est un st" + oDemande.Pascal() + "Corps"
	FIN

	// La ligne qui refuse (415) un corps qui n'est pas annoncé en JSON : le Content-Type de la requête est passé au Poinçon (MoiMême ne passe pas à une procédure). Absent : accepté. Elle précède la validation du corps.
	PROCEDURE EbLigneTypeContenu() : chaîne
		RENVOYER "EbPoinconExigeJson(MoiMême..Requête..Entêtes[" + EbGuillemets("Content-Type") + "])"
	FIN

	// La ligne qui valide le corps BRUT puis rend l'objet typé : EbPoinconValide lève 400 (corps vide, pas du JSON, pas un objet) ou 422 (une réponse qui nomme tout) AVANT tout appel du service. bPartiel : une modification partielle (PATCH). Elle suit EbLigneModele.
	PROCEDURE EbLigneValide(oDemande est un cEbDemandeMake, bCreation est un booléen, bPartiel est un booléen) : chaîne
		sPartiel est une chaîne = "Faux"
		SI bPartiel ALORS
			sPartiel = "Vrai"
		FIN
		RENVOYER "stCorps est un st" + oDemande.Pascal() + "Corps = EbPoinconValide(Schema" + oDemande.Pascal() + "(" + EbGuillemets(EbExclusionsCorps(oDemande, bCreation)) + ", stModele), MoiMême..Requête..Body, " + sPartiel + ")"
	FIN

	// Les lignes de la procédure qui construit le schéma du corps, à écrire dans le fichier du corps : il est lu dans ressource.json À CHAQUE REQUÊTE (modifier le fichier prend effet à la requête suivante) et rend un objet du type du modèle reçu.
	PROCEDURE EbLignesSchema(oDemande est un cEbDemandeMake) : tableau de chaînes
		tabLignes est un tableau de chaînes
		TableauAjoute(tabLignes, "// Le schéma du corps, lu dans " + EbCheminDescription(oDemande) + " À CHAQUE REQUÊTE : changez les règles, les défauts et « nullable » dans ce fichier, sans régénérer ce contrôleur. sExclus : les colonnes qui ne sont pas dans le corps ; stModele : une variable de st" + oDemande.Pascal() + "Corps, déclarée dans le contrôleur.")
		TableauAjoute(tabLignes, "PROCEDURE Schema" + oDemande.Pascal() + "(sExclus est une chaîne, stModele est une Structure) : cEbSchema")
		TableauAjoute(tabLignes, Caract(9) + "oSchema est un cEbSchema = EbSchemaDeRessource(" + EbGuillemets(EbCheminDescription(oDemande)) + ", sExclus, " + EbGuillemets(EbClesCorps(oDemande)) + ")")
		TableauAjoute(tabLignes, Caract(9) + "oSchema.Cible(stModele)")
		TableauAjoute(tabLignes, Caract(9) + "RENVOYER oSchema")
		TableauAjoute(tabLignes, "FIN")
		RENVOYER tabLignes
	FIN

	// Les lignes d'une modification PARTIELLE qui calculent la valeur finale de chaque champ non clé : la valeur du corps s'il a été envoyé (le texte brut le dit, JSONExiste, même pour zéro, faux ou texte vide), sinon celle de la ligne actuelle (oActuel).
	PROCEDURE EbLignesFusion(oDemande est un cEbDemandeMake) : tableau de chaînes
		tabLignes est un tableau de chaînes
		TableauAjoute(tabLignes, "jCorps est un JSON = ChaîneVersJSON(MoiMême..Requête..Body)")
		TableauAjoute(tabLignes, "oActuel est un c" + oDemande.Pascal() + " = oService.Trouve(cle)")
		POUR TOUT oChamp DE oDemande.Champs()
			SI PAS oChamp.Cle() ALORS
				TableauAjoute(tabLignes, EbVariablePartielle(oChamp) + " est " + EbTypeMembreCorps(oChamp) + " = oActuel." + oChamp.NomAccesseur() + "()")
				TableauAjoute(tabLignes, "SI JSONExiste(jCorps, " + EbGuillemets(oChamp.Slug()) + ") ALORS")
				TableauAjoute(tabLignes, Caract(9) + EbVariablePartielle(oChamp) + " = stCorps." + EbMembreCorps(oChamp))
				TableauAjoute(tabLignes, "FIN")
			FIN
		FIN
		RENVOYER tabLignes
	FIN
	// Les arguments du constructeur de l'entité pour une création (sCle vide : la clé générée vaut 0) ou un remplacement (sCle = « cle »). Les autres valeurs viennent du corps (un champ absent prend la valeur par défaut du type).
	PROCEDURE EbArgumentsCorps(oDemande est un cEbDemandeMake, sCle est une chaîne) : chaîne
		sRes est une chaîne = ""
		POUR TOUT oChamp DE oDemande.Champs()
			SI sRes <> "" ALORS
				sRes += ", "
			FIN
			SI oChamp.Cle() ET sCle <> "" ALORS
				sRes += sCle
			SINON
				SI EbCleGeneree(oChamp) ALORS
					sRes += "0"
				SINON
					sRes += EbValeurCorps(oChamp)
				FIN
			FIN
		FIN
		RENVOYER sRes
	FIN

	// Les arguments du constructeur de l'entité pour une modification PARTIELLE : la clé de l'adresse, et pour chaque autre champ sa valeur finale (EbLignesFusion : celle du corps s'il a été envoyé, sinon celle de la ligne actuelle).
	PROCEDURE EbArgumentsPartiels(oDemande est un cEbDemandeMake) : chaîne
		sRes est une chaîne = ""
		POUR TOUT oChamp DE oDemande.Champs()
			SI sRes <> "" ALORS
				sRes += ", "
			FIN
			SI oChamp.Cle() ALORS
				sRes += "cle"
			SINON
				sRes += EbVariablePartielle(oChamp)
			FIN
		FIN
		RENVOYER sRes
	FIN

	// ---- La liste : pagination, tri et filtres ----

	// Les noms des paramètres de l'adresse de la liste : page, limite, tri, ordre, puis un filtre par colonne (« filtre_<clé JSON> »). Ils servent d'identifiants OWL : jamais « taille » (OWL le prend pour la native Taille).
	PROCEDURE EbNomsRequeteListe(oDemande est un cEbDemandeMake) : chaîne
		sRes est une chaîne = "page, limite, tri, ordre"
		POUR TOUT oChamp DE oDemande.Champs()
			sRes += ", filtre_" + oChamp.Slug()
		FIN
		RENVOYER sRes
	FIN

	// Les paramètres de surRequête de la liste : tous des TEXTES vides par défaut (OWL rend Null un paramètre absent quand un suivant est présent et avale un type raté : cEbCriteresListe lit, décode et contrôle).
	PROCEDURE EbParametresListe(oDemande est un cEbDemandeMake) : chaîne
		sRes est une chaîne = "page est une chaîne = " + EbGuillemets("") + ", limite est une chaîne = " + EbGuillemets("") + ", tri est une chaîne = " + EbGuillemets("") + ", ordre est une chaîne = " + EbGuillemets("")
		POUR TOUT oChamp DE oDemande.Champs()
			sRes += ", filtre_" + oChamp.Slug() + " est une chaîne = " + EbGuillemets("")
		FIN
		RENVOYER sRes
	FIN

	// Les lignes qui construisent les critères : un AjouteChamp par colonne (tri et filtre), Recu (les noms de la query reçue : un paramètre inconnu est refusé au lieu d'être ignoré), puis Verifie() qui lève UN 400 pour tout ce qui est mal formé.
	PROCEDURE EbLignesCriteres(oDemande est un cEbDemandeMake) : tableau de chaînes
		tabLignes est un tableau de chaînes
		TableauAjoute(tabLignes, "oCriteres est un cEbCriteresListe(page, limite, tri, ordre)")
		POUR TOUT oChamp DE oDemande.Champs()
			TableauAjoute(tabLignes, "oCriteres.AjouteChamp(" + EbGuillemets(oChamp.Slug()) + ", " + EbGuillemets(oChamp.NomColonne()) + ", " + EbGuillemets(oChamp.TypeChamp()) + ", filtre_" + oChamp.Slug() + ")")
		FIN
		TableauAjoute(tabLignes, "oCriteres.Recu(MoiMême..Requête..Chemin)")
		TableauAjoute(tabLignes, "oCriteres.Verifie()")
		RENVOYER tabLignes
	FIN
	// Une opération : l'en-tête, puis la procédure avec son QUAND EXCEPTION. tabCorps : les lignes du bloc protégé (indentées d'un cran de plus que « QUAND EXCEPTION »).
	PROCEDURE EbOperationRoutes(oTexte est un cEbTexteCode, sNom est une chaîne, sMethode est une chaîne, sChemin est une chaîne, sRequete est une chaîne, sReponses est une chaîne, sCodeEtat est une chaîne, sParametres est une chaîne, tabCorps est un tableau de chaînes, sDepot est une chaîne, sService est une chaîne)
		oTexte.LigneVide()
		oTexte.Ligne(1, sNom + " est une OpérationHTTP")
		oTexte.Ligne(2, "PROPRIETES")
		oTexte.Ligne(3, "Méthode  = " + sMethode)
		oTexte.Ligne(3, "Chemin   = " + sChemin)
		SI sRequete <> "" ALORS
			oTexte.Ligne(3, "Requête  = [" + sRequete + "]")
		FIN
		oTexte.Ligne(3, "Réponses = [" + sReponses + "]")
		oTexte.Ligne(3, "CodeÉtat = " + sCodeEtat)
		oTexte.Ligne(2, "FIN")
		oTexte.Ligne(2, "PROCEDURE surRequête(" + sParametres + ") : chaîne")
		oTexte.Ligne(3, "oRepository est un " + sDepot + "(cEbServiceBase.Base())")
		oTexte.Ligne(3, "oService est un " + sService + "(oRepository)")
		oTexte.Ligne(3, "sCode  est une chaîne = " + EbGuillemets(""))
		oTexte.Ligne(3, "QUAND EXCEPTION DANS")
		POUR TOUT sLigne DE tabCorps
			oTexte.Ligne(4, sLigne)
		FIN
		oTexte.Ligne(3, "FAIRE")
		oTexte.Ligne(4, "sCode = ExceptionInfo(errCode)")
		oTexte.Ligne(4, "EbJournaliseErreurHttp(sCode, ExceptionInfo(errMessage))")
		oTexte.Ligne(4, "MoiMême..Réponse..CodeÉtat    = EbStatutHttpDeCode(sCode)")
		oTexte.Ligne(4, "MoiMême..Réponse..TypeContenu = " + EbGuillemets("application/json"))
		oTexte.Ligne(4, "MoiMême..Réponse..Corps       = EbCorpsErreurHttp(sCode, ExceptionInfo(errMessage))")
		oTexte.Ligne(3, "FIN")
		oTexte.Ligne(3, "RENVOYER " + EbGuillemets(""))
		oTexte.Ligne(2, "FIN")
		oTexte.Ligne(1, "FIN")
	FIN

	// Le chemin du fichier du corps (la structure et le schéma), relatif au projet : à côté du contrôleur.
	PROCEDURE EbCheminCorps(oDemande est un cEbDemandeMake) : chaîne
		RENVOYER "app/http/" + oDemande.Dossier() + "/Corps" + oDemande.Pascal() + ".owl"
	FIN

	// Le fichier du corps : la procédure qui rend le schéma (lu dans ressource.json) que EbPoinconValide applique au texte reçu. Une Collection (un ServiceREST n'accepte pas de procédure à son niveau), à n'écrire que si EbChampsSansRoutes est vide.
	// La structure du corps n'est PAS ici : elle est dans le contrôleur (voir EbLigneModele).
	PROCEDURE EbContenuCorps(oDemande est un cEbDemandeMake) : chaîne
		sPascal est une chaîne      = oDemande.Pascal()
		oTexte  est un cEbTexteCode
		oTexte.Ligne(0, "// Le schéma du corps d'une création, d'un remplacement ou d'une modification de « " + EbNomAffiche(oDemande) + " » : EbPoinconValide l'applique au texte reçu, avant tout appel du service. La structure qu'il remplit est dans le contrôleur.")
		oTexte.Ligne(0, "Corps" + sPascal + " est une CollectionDeProcédures")
		oTexte.LigneVide()
		POUR TOUT sLigneSchema DE EbLignesSchema(oDemande)
			oTexte.Ligne(1, sLigneSchema)
		FIN
		oTexte.Ligne(0, "FIN")
		RENVOYER oTexte.Texte()
	FIN

	// Le contrôleur. À n'appeler que si EbChampsSansRoutes est vide.
	PROCEDURE EbContenuRoutes(oDemande est un cEbDemandeMake) : chaîne
		sPascal  est une chaîne       = oDemande.Pascal()
		sDepot   est une chaîne       = "cRepo" + sPascal + "Sql"
		sService est une chaîne       = "cService" + sPascal
		sSegment est une chaîne       = EbGuillemets(EbSegmentRoutes(oDemande))
		sTypeCle est une chaîne       = EbArticleTypeOwl(EbTypeCleOwl(oDemande))
		oCle     est un cEbChampTable = EbChampCle(oDemande.Champs())
		// Le 400 est toujours annoncé : une adresse ou un corps mal formés. Le 422 (données invalides : champ obligatoire absent, règle de ressource.json violée) n'est PAS dans Réponses : OWL refuse un nombre en dur dans cette liste ; le Poinçon le pose à l'exécution.
		sBad   est une chaîne      = "httpRequêteIncorrecte, "
		sBase  est une chaîne      = "httpServiceIndisponible, httpErreurServeur"
		oTexte est un cEbTexteCode
		oTexte.Ligne(0, "Controleur" + sPascal + " est un ServiceREST")
		oTexte.Ligne(1, "PROPRIETES")
		oTexte.Ligne(2, "UrlBase = [" + EbGuillemets("api") + "]")
		// Les propriétés du garde fourni par les modules du projet (par exemple le schéma d'authentification), une ligne chacune.
		POUR TOUT sPropriete DE oDemande.GardeProprietes()
			oTexte.Ligne(2, sPropriete)
		FIN
		oTexte.Ligne(1, "FIN")
		oTexte.LigneVide()
		// La structure que remplit OWL APRÈS la validation du texte reçu (le schéma est dans Corps<Nom>.owl).
		oTexte.Ligne(1, "// Un champ envoyé vaut ce qui a été envoyé ; un champ absent vaut son défaut (ressource.json), sinon celui du type. Aucune valeur sentinelle : le texte reçu dit ce qui manque.")
		oTexte.Ligne(1, "st" + sPascal + "Corps est une Structure")
		POUR TOUT oChamp DE EbChampsCorps(oDemande)
			oTexte.Ligne(2, EbMembreCorps(oChamp) + " est " + EbTypeMembreCorps(oChamp))
		FIN
		oTexte.Ligne(1, "FIN")
		oTexte.LigneVide()
		SI oDemande.GardePresente() ALORS
			// Les procédures du garde, écrites telles quelles (les tabulations relatives sont dans le texte) : le cœur ne sait pas ce qu'elles font.
			POUR TOUT sLigneGarde DE oDemande.GardeProcedures()
				SI sLigneGarde = "" ALORS
					oTexte.LigneVide()
				SINON
					oTexte.Ligne(1, sLigneGarde)
				FIN
			FIN
			oTexte.LigneVide()
		SINON
			oTexte.Ligne(1, "// ROUTES OUVERTES : aucun module de ce projet ne fournit de garde, donc aucune route n'exige de jeton.")
			oTexte.LigneVide()
		FIN
		oTexte.Ligne(1, "PROCEDURE surErreur()")
		oTexte.Ligne(2, "EbJournaliseErreurHttp(" + EbGuillemets("500") + ", ExceptionInfo(errMessage))")
		oTexte.Ligne(2, "MoiMême..Réponse..CodeÉtat    = httpErreurServeur")
		oTexte.Ligne(2, "MoiMême..Réponse..TypeContenu = " + EbGuillemets("application/json"))
		oTexte.Ligne(2, "MoiMême..Réponse..Corps       = EbCorpsErreurHttp(" + EbGuillemets("500") + ", " + EbGuillemets("") + ")")
		oTexte.Ligne(1, "FIN")


		// Liste : une page sous les critères de l'adresse (page, limite, tri, ordre, filtre_<colonne>), dans { donnees, meta } ; les critères sont contrôlés avant tout appel du service (UN seul 400).
		tabCorps est un tableau de chaînes
		POUR TOUT sLigneCriteres DE EbLignesCriteres(oDemande)
			TableauAjoute(tabCorps, sLigneCriteres)
		FIN
		TableauAjoute(tabCorps, "sJson est une chaîne = " + EbGuillemets(""))
		TableauAjoute(tabCorps, "POUR TOUT oEntite DE oService.EnumerePage(oCriteres)")
		TableauAjoute(tabCorps, Caract(9) + "SI sJson <> " + EbGuillemets("") + " ALORS")
		TableauAjoute(tabCorps, Caract(9) + Caract(9) + "sJson += " + EbGuillemets(","))
		TableauAjoute(tabCorps, Caract(9) + "FIN")
		TableauAjoute(tabCorps, Caract(9) + "sJson += oEntite.EnJson()")
		TableauAjoute(tabCorps, "FIN")
		TableauAjoute(tabCorps, "MoiMême..Réponse..TypeContenu = " + EbGuillemets("application/json"))
		TableauAjoute(tabCorps, "MoiMême..Réponse..Corps       = EbListeReponse(sJson, oService.Compte(oCriteres), oCriteres)")
		EbOperationRoutes(oTexte, "Liste" + sPascal, "httpGet", "[" + sSegment + "]", EbNomsRequeteListe(oDemande), "httpOK, " + sBad + sBase, "httpOK", EbParametresListe(oDemande), tabCorps, sDepot, sService)
		// Lecture
		TableauSupprimeTout(tabCorps)
		TableauAjoute(tabCorps, "oEntite est un c" + sPascal + " = oService.Trouve(cle)")
		TableauAjoute(tabCorps, "MoiMême..Réponse..TypeContenu = " + EbGuillemets("application/json"))
		TableauAjoute(tabCorps, "MoiMême..Réponse..Corps       = oEntite.EnJson()")
		EbOperationRoutes(oTexte, "Lit" + sPascal, "httpGet", "[" + sSegment + ", cle]", "", "httpOK, httpNonTrouvé, " + sBase, "httpOK", "cle est " + sTypeCle, tabCorps, sDepot, sService)

		// Création
		TableauSupprimeTout(tabCorps)
		TableauAjoute(tabCorps, "oNouveau est un c" + sPascal + "(" + EbArgumentsCorps(oDemande, "") + ")")
		TableauAjoute(tabCorps, "oEnregistre est un c" + sPascal + " = oService.Ajoute(oNouveau)")
		TableauAjoute(tabCorps, "MoiMême..Réponse..TypeContenu = " + EbGuillemets("application/json"))
		TableauAjoute(tabCorps, "MoiMême..Réponse..Corps       = oEnregistre.EnJson()")
		// 409 : une clé texte déjà prise, ou une clé étrangère violée (une colonne qui vise une ligne absente) : le second cas existe pour toute ressource.
		sReponsesCree est une chaîne            = "httpCréé, " + sBad + "httpTypeMédiaNonSupporté, httpConflit, "
		tabAvec       est un tableau de chaînes
		TableauAjoute(tabAvec, EbLigneTypeContenu())
		TableauAjoute(tabAvec, EbLigneModele(oDemande))
		TableauAjoute(tabAvec, EbLigneValide(oDemande, Vrai, Faux))
		POUR TOUT sLigneCorps DE tabCorps
			TableauAjoute(tabAvec, sLigneCorps)
		FIN
		EbOperationRoutes(oTexte, "Cree" + sPascal, "httpPost", "[" + sSegment + "]", "", sReponsesCree + sBase, "httpCréé", "", tabAvec, sDepot, sService)

		// Remplacement (PUT) : toute la ligne, les champs obligatoires doivent tous être là
		TableauSupprimeTout(tabCorps)
		TableauAjoute(tabCorps, "oChange est un c" + sPascal + "(" + EbArgumentsCorps(oDemande, "cle") + ")")
		TableauAjoute(tabCorps, "oService.Modifie(oChange)")
		TableauAjoute(tabCorps, "MoiMême..Réponse..TypeContenu = " + EbGuillemets("application/json"))
		TableauAjoute(tabCorps, "MoiMême..Réponse..Corps       = oChange.EnJson()")
		TableauSupprimeTout(tabAvec)
		TableauAjoute(tabAvec, EbLigneTypeContenu())
		TableauAjoute(tabAvec, EbLigneModele(oDemande))
		TableauAjoute(tabAvec, EbLigneValide(oDemande, Faux, Faux))
		POUR TOUT sLigneCorps DE tabCorps
			TableauAjoute(tabAvec, sLigneCorps)
		FIN
		EbOperationRoutes(oTexte, "Modifie" + sPascal, "httpPut", "[" + sSegment + ", cle]", "", "httpOK, " + sBad + "httpTypeMédiaNonSupporté, httpNonTrouvé, httpConflit, " + sBase, "httpOK", "cle est " + sTypeCle, tabAvec, sDepot, sService)

		// Modification partielle (PATCH) : seuls les champs envoyés changent, les autres gardent la valeur de la ligne actuelle
		TableauSupprimeTout(tabCorps)
		TableauAjoute(tabCorps, "oChange est un c" + sPascal + "(" + EbArgumentsPartiels(oDemande) + ")")
		TableauAjoute(tabCorps, "oService.Modifie(oChange)")
		TableauAjoute(tabCorps, "MoiMême..Réponse..TypeContenu = " + EbGuillemets("application/json"))
		TableauAjoute(tabCorps, "MoiMême..Réponse..Corps       = oChange.EnJson()")
		// Le corps est validé AVANT de chercher la ligne : un corps invalide sur une ligne absente donne 400 ou 422, pas 404.
		tabPartiel est un tableau de chaînes
		TableauAjoute(tabPartiel, EbLigneTypeContenu())
		TableauAjoute(tabPartiel, EbLigneModele(oDemande))
		TableauAjoute(tabPartiel, EbLigneValide(oDemande, Faux, Vrai))
		POUR TOUT sLigneFusion DE EbLignesFusion(oDemande)
			TableauAjoute(tabPartiel, sLigneFusion)
		FIN
		POUR TOUT sLigneCorps DE tabCorps
			TableauAjoute(tabPartiel, sLigneCorps)
		FIN
		EbOperationRoutes(oTexte, "Corrige" + sPascal, "httpPatch", "[" + sSegment + ", cle]", "", "httpOK, " + sBad + "httpTypeMédiaNonSupporté, httpNonTrouvé, httpConflit, " + sBase, "httpOK", "cle est " + sTypeCle, tabPartiel, sDepot, sService)

		// Suppression
		TableauSupprimeTout(tabCorps)
		TableauAjoute(tabCorps, "oService.Supprime(cle)")
		EbOperationRoutes(oTexte, "Supprime" + sPascal, "httpDelete", "[" + sSegment + ", cle]", "", "httpSansContenu, httpNonTrouvé, httpConflit, " + sBase, "httpSansContenu", "cle est " + sTypeCle, tabCorps, sDepot, sService)

		oTexte.Ligne(0, "FIN")
		RENVOYER oTexte.Texte()
	FIN
FIN
