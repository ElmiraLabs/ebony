// Un UPDATE en cours de construction : db.Update(produits).Set(ligne).Where(produits.Id.Eq(3)).ToSQL(). Les valeurs à écrire sont un tableau associatif colonne -> valeur, vérifiées contre leur colonne dès Set().
// GARDE-FOU : un Update SANS condition est refusé (7008), sauf demande explicite par ForAllRows(). OWL n'a pas de types pour empêcher l'oubli, et une table entière réécrite par un Where oublié est le pire accident possible :
// une condition vide (des filtres facultatifs tous absents) compte pour « pas de condition ». ForAllRows() avec une condition est contradictoire, donc refusé aussi (7008).
cEbUpdate est une Classe
PRIVÉ
	oDialecte   est un iEbDialecteSql
	oTable      est un cEbTable
	tabColonnes est un tableau
	tabValeurs  est un tableau associatif
	oCondition  est un cEbSql
	bCondition  est un booléen            = Faux
	bToutes     est un booléen            = Faux
	tabRetour   est un tableau

	PROCEDURE Constructeur(Dialecte est un iEbDialecteSql, TableCible est un cEbTable)
		:oDialecte = Dialecte
		:oTable = TableCible
	FIN

	// Les valeurs à écrire : un tableau associatif colonne -> valeur. Un nouvel appel remplace le précédent. Lève (7001, 7002) pour une colonne inconnue, une valeur refusée ou un tableau vide.
	PROCEDURE PUBLIQUE Set(ligne est un tableau associatif) : cEbUpdate
		:tabColonnes = EbColonnesDeLigne(:oTable, ligne, "Set")
		tabCopie est un tableau associatif
		POUR TOUT oCandidate DE :tabColonnes
			oColonne est un cEbColonne = oCandidate
			tabCopie[oColonne.Nom()] = EbValeurDeLigne(ligne, oColonne)
		FIN
		:tabValeurs = tabCopie
		RENVOYER objet
	FIN

	// La condition (cEbSql). Remplace la précédente ; une condition vide est ignorée (et laisse l'Update sans condition : voir le garde-fou).
	PROCEDURE PUBLIQUE Where(oExpression est un cEbSql) : cEbUpdate
		SI oExpression.Vide() ALORS
			:bCondition = Faux
		SINON
			:oCondition = oExpression
			:bCondition = Vrai
		FIN
		RENVOYER objet
	FIN

	// Ajoute une condition à la précédente par AND ; sans condition précédente, c'est la condition. Une condition vide est ignorée.
	PROCEDURE PUBLIQUE AndWhere(oExpression est un cEbSql) : cEbUpdate
		:Combine(" AND ", oExpression)
		RENVOYER objet
	FIN

	// Ajoute une condition à la précédente par OR ; sans condition précédente, c'est la condition. Une condition vide est ignorée.
	PROCEDURE PUBLIQUE OrWhere(oExpression est un cEbSql) : cEbUpdate
		:Combine(" OR ", oExpression)
		RENVOYER objet
	FIN

	PROCEDURE Combine(sOperateur est une chaîne, oExpression est un cEbSql)
		SI oExpression.Vide() ALORS
			RETOUR
		FIN
		:oCondition = EbJointCondition(sOperateur, :oCondition, :bCondition, oExpression)
		:bCondition = Vrai
	FIN

	// Demande explicitement de réécrire TOUTES les lignes de la table : la seule façon d'écrire un Update sans condition.
	PROCEDURE PUBLIQUE ForAllRows() : cEbUpdate
		:bToutes = Vrai
		RENVOYER objet
	FIN

	// Demande que la base rende cette colonne pour chaque ligne modifiée (RETURNING), sous l'alias « table__colonne ». Lève (7001) pour une colonne d'une autre table.
	PROCEDURE PUBLIQUE Returning(oColonne est un cEbColonne) : cEbUpdate
		EbVerifieColonneDeLaTable(:oTable, oColonne, "Returning")
		TableauAjoute(:tabRetour, oColonne)
		RENVOYER objet
	FIN

	// Le texte SQL et ses paramètres, sans aucune base. Lève (7006) sans Set, (7001) pour une colonne d'une autre table dans la condition, (7008) pour un Update sans condition et sans ForAllRows().
	PROCEDURE PUBLIQUE ToSQL() : cEbRequete
		SI :tabColonnes..Occurrence = 0 ALORS
			ExceptionDéclenche(7006, "Requête incomplète : Update(" + :oTable.Nom() + ") sans valeur, Set() n'a pas été appelé.")
		FIN
		SI :bCondition ALORS
			EbVerifieColonnes(:oTable, :oCondition)
			SI :bToutes ALORS
				ExceptionDéclenche(7008, "Update(" + :oTable.Nom() + ") refusé : ForAllRows() demande de réécrire toutes les lignes, mais une condition est donnée. Retirez l'un des deux.")
			FIN
		SINON
			SI PAS :bToutes ALORS
				ExceptionDéclenche(7008, "Update(" + :oTable.Nom() + ") refusé : aucune condition, donc toutes les lignes seraient réécrites. Ajoutez un Where(), ou appelez ForAllRows() si c'est voulu. (Une condition vide, des filtres facultatifs tous absents, compte pour aucune condition.)")
			FIN
		FIN
		oSql est un cEbSql
		oSql.AjouteTexte("UPDATE ")
		oSql.AjouteNomTable(:oTable.Nom())
		oSql.AjouteTexte(" SET ")
		nRang est un entier = 0
		POUR TOUT oCandidate DE :tabColonnes
			oColonne est un cEbColonne = oCandidate
			nRang++
			SI nRang > 1 ALORS
				oSql.AjouteTexte(", ")
			FIN
			oSql.AjouteTable(oColonne.Nom())
			oSql.AjouteTexte(" = ")
			oSql.AjouteValeur(:tabValeurs[oColonne.Nom()])
		FIN
		SI :bCondition ALORS
			oSql.AjouteTexte(" WHERE ")
			oSql.AjouteSql(:oCondition)
		FIN
		oSql.AjouteTexte(EbFinRetour(:oDialecte, :tabRetour))
		RENVOYER oSql.Construit(:oDialecte)
	FIN
FIN
